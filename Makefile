	rc=$$?; \
	if [ $$rc -ne 0 ]; then echo "music path FAILED (rc=$$rc)"; cat /tmp/opencode/mus_ci.log; exit 1; fi; \
	grep -q 'll_music: playing tunga.MOD' /tmp/opencode/mus_ci.log || \
	{ echo "music path: tunga.MOD never started"; cat /tmp/opencode/mus_ci.log; exit 1; }; \
	python3 tools/verify_music.py /tmp/opencode/mus_ci
else
	@echo "verify-music: SKIP (needs $(DATA)/ETAPY/1/MUSIC.SSEQ; see the restaging recipe in NEXT_STEPS.md"
endif

# PR-194: THE STAGE-DRIVER EXIT CONTRACT AS BEHAVIOUR (ported/ll_stage.h,
# the read is PR-193 F2/F3/F4). TWO HALVES.
#   (a) fixture-free: the decision table itself (./stage_selftest, 11
#       cases) - runs in every configuration, fixtures or not.
#   (b) fixture-backed: the four codes driven through the real RAN.01 play
#       leg with LEO_LEVEL_EXIT="<tick>:<code>", which states "the level
#       ended at that tick with that code". The port does NOT invent a
#       producer for the code: the authored `.MOV` directive `end_level <n>`
#       is the candidate the data names and its runtime executor is unread
#       (the note above stage_apply: in ported/ll_level.c says the same).
# The frame equalities are the point of this leg, and they are exact:
#   exit 4 stops the loop (the engine's 0x5d3ec), and exit 2 with an EMPTY
#     queue stops through the engine's OWN empty-queue leg (0x5d38e), so a
#     100-tick run that stops at tick 50 is byte-identical to a 50-tick run;
#   exit 1 is the default leg (0x5d3dc): run on with NO reset, so the frame
#     is byte-identical to the run with no code injected at all;
#   exit 3 resets, and the strongest form of that is the byte-level one: 50
#     ticks AFTER a reset at tick 50 are byte-identical to the 50 ticks of
#     the same script with no reset - and not to the unreset 100-tick frame.
# A run WITHOUT LEO_LEVEL_EXIT prints no driver line at all: the contract is
# inert, which is why every pre-existing play pin is untouched.
verify-stage: stage_selftest ll_level
# (a) the contract, no data and no window
	@timeout 30 ./stage_selftest
ifeq ($(PX_DATA),1)
# (b) the four outcomes, driven
	@rm -f /tmp/opencode/stg_*.ppm /tmp/opencode/stg_*.log; \
	run() { env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	          LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	          LEO_PLAY_SCRIPT="1:FWD" \
	          LEO_LEVEL_PPM=/tmp/opencode/stg_$$1.ppm LEO_LEVEL_PPM_TICK=$$2 \
	          $${3:+LEO_LEVEL_EXIT=$$3} \
	          ./ll_level $(DATA) RAN.01 --play --no-audio \
	          > /tmp/opencode/stg_$$1.log 2>&1 \
	          || { echo "stage leg $$1 FAILED (rc=$$?)"; \
	               cat /tmp/opencode/stg_$$1.log; exit 1; }; }; \
	run base 100 ""; run t50 50 ""; run stop4 100 "50:4"; run stop2 100 "50:2"; \
	run again1 100 "50:1"; run reset3 100 "50:3"
	@! grep -q 'stage driver:' /tmp/opencode/stg_base.log \
	  && echo "stage driver INERT without LEO_LEVEL_EXIT: no line, no byte of the" \
	     "scene changed (ok)" \
	  || { echo "stage leg: a run without LEO_LEVEL_EXIT printed a driver line"; \
	       exit 1; }
	@grep -q 'stage driver: exit 4 at tick 50: STOP' /tmp/opencode/stg_stop4.log \
	  && grep -q 'the play leg ended at tick 50 of 100' /tmp/opencode/stg_stop4.log \
	  && cmp /tmp/opencode/stg_stop4.ppm /tmp/opencode/stg_t50.ppm \
	  && echo "exit 4 = stop (the engine 0x5d3ec): the 100-tick run that stops at" \
	     "tick 50 is BYTE-IDENTICAL to a 50-tick run (ok)" \
	  || { echo "exit-4 leg FAILED"; cat /tmp/opencode/stg_stop4.log; exit 1; }
	@grep -q 'exit 2 at tick 50: queue leg with an EMPTY queue' \
	     /tmp/opencode/stg_stop2.log \
	  && cmp /tmp/opencode/stg_stop2.ppm /tmp/opencode/stg_t50.ppm \
	  && echo "exit 2 + an empty queue = the engine's own empty-queue answer" \
	     "(0x5d38e): the same stop, the same bytes (ok)" \
	  || { echo "exit-2 leg FAILED"; cat /tmp/opencode/stg_stop2.log; exit 1; }
	@grep -q 'exit 1 at tick 50: run on, NO reset' /tmp/opencode/stg_again1.log \
	  && cmp /tmp/opencode/stg_again1.ppm /tmp/opencode/stg_base.ppm \
	  && echo "exit 1 = the default leg (0x5d3dc): runs on with NO reset, the frame" \
	     "identical to the run with no code at all (ok)" \
	  || { echo "exit-1 leg FAILED"; cat /tmp/opencode/stg_again1.log; exit 1; }
	@grep -q 'exit 3 at tick 50: RESET to the authored start' \
	     /tmp/opencode/stg_reset3.log \
	  && ! cmp -s /tmp/opencode/stg_reset3.ppm /tmp/opencode/stg_base.ppm \
	  && cmp /tmp/opencode/stg_reset3.ppm /tmp/opencode/stg_t50.ppm \
	  && echo "exit 3 = reset THEN run again: 50 ticks after a reset at tick 50 are" \
	     "BYTE-IDENTICAL to 50 ticks of the same script with no reset, and NOT the" \
	     "unreset 100-tick frame - the reset restored the authored state exactly" \
	     "(ok)" \
	  || { echo "exit-3 leg FAILED"; cat /tmp/opencode/stg_reset3.log; exit 1; }
else
	@echo "verify-stage: SKIP the four driven legs (needs $(DATA) + LEO_HD_DIR" \
	  "fixtures; see the restaging recipe in NEXT_STEPS.md); the contract half" \
	  "above ran"
endif

# PR-199: AN AUTHORED `.MOV` ROW IS THE PRODUCER OF THE LEVEL LOOP'S EXIT
# CODE 1. The read is PR-198: the row tail `end_level <n>` reaches a node
# of class 0xa1048, that class's apply method 0x45750 stores n into the
# level object's +0x4 slot (`mov ebx,ds:0xcef40; mov ecx,[node+0x8];
# mov [ebx+0x4],ecx`), and the level loop 0x4abd0 compares that slot
# against zero at the TOP of every iteration (0x4ac55) - a nonzero sets
# ebx=1 (0x4ac5b) and jumps to the loop's single epilogue 0x4ae53/0x4ae81,
# so the level function returns 1 whatever n was, and the copy published
# beside it (0x5d25e/0x5d2dc) has no reader in the image. The port:
# ll_play.c parses the tail (ll_mov_fr.endlv, data), the row admit writes
# the slot (ll_player.exit_word), ll_level.c's play loop tests it at its
# own top and hands code 1 to ll_stage_outcome. THREE THINGS ARE PINNED:
#   (a) the shipped rows, counted THROUGH THE PORT'S OWN PARSER: 26 rows
#       in 3 of the 777 .MOV members (25 x value 1, 1 x value 2), each one
#       named by level / leaf / state / row / authored frame / threshold -
#       and RAN.01, ZARIA.01 and every other level a play leg runs carry
#       ZERO, which is what makes the new path inert on all of those pins;
#   (b) the path driven end to end on RAN.01. That level's own data has no
#       such row (see (a)) and the three levels that do cannot be played
#       here (JUNCTION's own data says it has no ground; TUNGA's A_EXIT is
#       entered only by the arm `A_EXIT(x)=AC_RECT,AC_BLOK`), so the tail
#       is INJECTED into one authored row of the level's own text by
#       LEO_PLAY_ENDLV - see mov_inject_endlv in ported/ll_level.c for
#       exactly that and for what the injection does and does not prove.
#       From that byte onward every step is shipped code. The equalities
#       are the strong kind: the 60-tick run the row ends is
#       byte-identical to (i) a 6-tick run of the same injected script -
#       the end lands on the iteration boundary after the admit and NO
#       extra iteration ran, exactly the engine's shape, (ii) a run whose
#       injected value is 1 instead of 2 - the value selects nothing, and
#       (iii) a 6-tick run with NO injection at all - carrying the tail
#       changes not one byte of the simulation;
#   (c) the negative paths: an address that does not resolve prints its own
#       line and changes nothing, and with no LEO_PLAY_ENDLV no driver line
#       appears at all (PR-194's INERT pin, re-proved here with the new
#       code in the loop).
verify-endlevel: endlevel_census ll_level
ifeq ($(PX_DATA),1)
	@./endlevel_census $(HD)/ANIMACJE > /tmp/opencode/endlv_census.txt 2>&1 \
	  || { echo "end_level census FAILED"; cat /tmp/opencode/endlv_census.txt; \
	         exit 1; }
	@grep -qF 'census total: 777 .MOV member(s) parsed, 0 unreadable,' \
	        /tmp/opencode/endlv_census.txt \
	  && grep -qF '3 member(s) carry the tail, 26 row(s) with end_level' \
	        /tmp/opencode/endlv_census.txt \
	  && grep -qF 'value 1: 25 row(s)' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'value 2: 1 row(s)' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'JUNCTION/LEW.JUN state 2 [A_TUNGA1] row 41 (authored frame 42, threshold 200) end_level 1' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'JUNCTION/LEW.JUN state 3 [A_TUNGA2] row 81 (authored frame 82, threshold 200) end_level 2' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'TUNGA.11/LEW.TUN state 9 [A_EXIT] row 0 (authored frame 10, threshold 6) end_level 1' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'TUNGA2.12/LEW.TUN state 32 [A_EXIT] row 11 (authored frame 9, threshold 6) end_level 1' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'LEVEL RAN.01: 84 .MOV member(s), 0 end_level row(s)' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'LEVEL ZARIA.01: 33 .MOV member(s), 0 end_level row(s)' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'Wait-clause capture (PR-217): 133 member(s), 251 row(s)' /tmp/opencode/endlv_census.txt \
	  && grep -qF '161 of them a name with NO bit' /tmp/opencode/endlv_census.txt \
	  && grep -qF '21 negated' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'Wait operand kinds (PR-218): 230 with NO operator' /tmp/opencode/endlv_census.txt \
	  && grep -qF '161 name K_NEVER (OR-s' /tmp/opencode/endlv_census.txt \
	  && grep -qF '0 name K_ANY (OR-s' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'and 0 name a token in NO table' /tmp/opencode/endlv_census.txt \
	  && grep -qF 'LEVEL ZARIA.01: 33 .MOV member(s), 0 end_level row(s), 35 Wait-clause row(s) captured' /tmp/opencode/endlv_census.txt \
	  && echo "end_level rows counted by the port's own parser: 26 rows in 3 of" \
	     "the 777 .MOV members (25 x value 1, 1 x value 2), each named by level," \
	     "leaf, state, row, authored frame and threshold; RAN.01 and ZARIA.01" \
	     "carry ZERO, so the new path cannot move those legs' frames (ok)" \
	  || { echo "end_level census leg FAILED:"; \
	         grep -E '^(LEVEL|value|census)' /tmp/opencode/endlv_census.txt; \
	         exit 1; }
	@rm -f /tmp/opencode/endlv_*.ppm /tmp/opencode/endlv_*.log; \
	run() { env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	          LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	          LEO_PLAY_SCRIPT="1:FWD" \
	          LEO_LEVEL_PPM=/tmp/opencode/endlv_$$1.ppm LEO_LEVEL_PPM_TICK=$$2 \
	          $${3:+LEO_PLAY_ENDLV=$$3} \
	          ./ll_level $(DATA) RAN.01 --play --no-audio \
	          > /tmp/opencode/endlv_$$1.log 2>&1 \
	          || { echo "end-level leg $$1 FAILED (rc=$$?)"; \
	               cat /tmp/opencode/endlv_$$1.log; exit 1; }; }; \
	run end2 60 "23:1:2"; run exact 6 "23:1:2"; run end1 60 "23:1:1"; \
	run plain6 6 ""; run plain60 60 ""; run oor 60 "0:5:1"
	@grep -qF 'end_level INJECTED on state 23 row 1 of the level'"'"'s own .MOV text: the line now reads "2,6,end_level 2"' /tmp/opencode/endlv_end2.log \
	  && grep -qF 'stage driver: exit 1 at tick 6: run on, NO reset (the engine'"'"'s 0x5d3dc)' /tmp/opencode/endlv_end2.log \
	  && grep -qF 'exit word 2 from an authored end_level row: the level loop returns 1 (0x4ac5b -> the single epilogue 0x4ae53) at tick 6 of 60' /tmp/opencode/endlv_end2.log \
	  && echo "the injected row admitted on tick 5 ends the run at the TOP of tick" \
	     "7 (reported as the last completed tick 6): the contract line names code" \
	     "1 and the producer line names the slot, the value and the addresses (ok)" \
	  || { echo "end-level driven leg FAILED"; cat /tmp/opencode/endlv_end2.log; \
	         exit 1; }
	@cmp /tmp/opencode/endlv_end2.ppm /tmp/opencode/endlv_exact.ppm \
	  && cmp /tmp/opencode/endlv_end2.ppm /tmp/opencode/endlv_end1.ppm \
	  && cmp /tmp/opencode/endlv_end2.ppm /tmp/opencode/endlv_plain6.ppm \
	  && echo "the run the authored row ends is BYTE-IDENTICAL to a 6-tick run of" \
	     "the same injected script (no extra iteration ran), to a run injected with" \
	     "value 1 instead of 2 (the value selects nothing - PR-198 measured the" \
	     "same loop return for every value), and to a 6-tick run with NO injection" \
	     "at all (carrying the tail changes no byte of the simulation) (ok)" \
	  || { echo "end-level byte leg FAILED"; ls -l /tmp/opencode/endlv_*.ppm; \
	         exit 1; }
	@grep -qF "LEO_PLAY_ENDLV='0:5:1' names state 0 row 5, which this .MOV does not have" /tmp/opencode/endlv_oor.log \
	  && cmp /tmp/opencode/endlv_oor.ppm /tmp/opencode/endlv_plain60.ppm \
	  && ! grep -q 'stage driver:' /tmp/opencode/endlv_oor.log \
	  && ! grep -q 'stage driver:' /tmp/opencode/endlv_plain60.log \
	  && echo "an address that does not resolve names itself and changes NOTHING" \
	     "(byte-identical to the plain 60-tick run), and without LEO_PLAY_ENDLV no" \
	     "driver line appears at all - the new top-of-loop test is inert on the" \
	     "shipped rows of every level these legs run (ok)" \
	  || { echo "end-level negative leg FAILED"; cat /tmp/opencode/endlv_oor.log; \
	         exit 1; }
else
	@echo "verify-endlevel: SKIP the census and the driven legs (needs $(DATA) +" \
	  "LEO_HD_DIR fixtures; see the restaging recipe in NEXT_STEPS.md)"
endif

# P-07 end-to-end: game data + output paths through a non-ASCII
# directory (the review's "C:\Gry\Łódź\" case).  Linux proves the
# engine itself is path-encoding agnostic; the wine runs prove the
# windows binary loads data + writes PPM + passes the DATA probe there.
# (On real Windows the UCRT + activeCodePage=UTF-8 manifest makes even
# the ANSI fast path UTF-8; ll_fopen_ci's _wfopen fallback covers
# environments without that manifest.  Do NOT run the wine legs under
# LC_ALL=C: wine mangles non-ASCII argv before the app sees it.)
verify-utf8: ll_cutscene ll_cutscene.exe py-refs
# py-refs is a prerequisite, not a courtesy: this leg cmp's BOTH of its
# PPMs against /tmp/opencode/c_py/f01020.ppm, which ONLY `make py-refs`
# produces. Measured on a freshly staged machine 2026-11-19: without it
# the leg failed at the first cmp (`cmp: /tmp/opencode/c_py/f01020.ppm:
# No such file`, rc=2) while every other consumer of that file
# (verify:110, verify-skip:127, verify-win:143, verify-cmake:2143,
# verify-golden:2251) already lists it. No leg logic changed.
ifeq ($(PX_DATA),1)
	@mkdir -p "/tmp/opencode/Gry/Łódź" && \
	  ln -sfn "$(DATA)" "/tmp/opencode/Gry/Łódź/LEO"
	./ll_cutscene "/tmp/opencode/Gry/Łódź/LEO/INTRO_P.IS" --ppm 1020 \
	  "/tmp/opencode/Gry/Łódź/l1020.ppm"
	cmp "/tmp/opencode/Gry/Łódź/l1020.ppm" /tmp/opencode/c_py/f01020.ppm \
	  && echo "linux utf-8 path: read+write (ok)"
	env -u DISPLAY WINEPREFIX=$(WINEPREFIX) WINEDEBUG=-all \
	  wine ./ll_cutscene.exe "Z:/tmp/opencode/Gry/Łódź/LEO/INTRO_P.IS" \
	  --ppm 1020 "Z:/tmp/opencode/Gry/Łódź/w1020.ppm"
	cmp "/tmp/opencode/Gry/Łódź/w1020.ppm" /tmp/opencode/c_py/f01020.ppm \
	  && echo "win utf-8 path: read+write byte-exact (ok)"
	@env -u DISPLAY WINEPREFIX=$(WINEPREFIX) WINEDEBUG=-all \
	  LEO_MENU_SECS=1 LEO_MENU_AUTO=1 \
	  wine ./ll_cutscene.exe --menu "Z:/tmp/opencode/Gry/Łódź/LEO" \
	  --no-audio 2>&1 | tr -d '\r' | grep -q 'DATA .*Łódź.*: complete' \
	  && echo "win utf-8 DATA dir: discovery + probe (ok)"
else
	@echo "verify-utf8: SKIP (data-backed half needs $(DATA)/INTRO_P.IS; the PIN_UTF8_DIR no-data half cannot run standalone)"
endif

package-win: ll_cutscene.exe
	python3 tools/package.py --win

package-linux: ll_cutscene
	python3 tools/package.py --linux

package: package-win package-linux

# T-25: seeded parser fuzzing over REAL payloads (tools/fuzz.c docs).
# Three fixed seeds keep it deterministic; ASan/UBSan turn any parser
# slip into a hard failure. Corpus comes from DATA, so it tracks the
# real formats.
fuzz: tools/fuzz.c ported/is_stream.c ported/llrs.c ported/ll_pcx.c \
      ported/ll_seq.c ported/ll_pcm.c ported/ll_mod.c ported/fs_ci.c
	$(CC) -O1 -g -std=gnu11 -Wall -Wextra $(SAN) \
	    -Iported -o $@ tools/fuzz.c ported/is_stream.c ported/llrs.c \
	    ported/ll_pcx.c ported/ll_seq.c ported/ll_pcm.c ported/ll_mod.c \
	    ported/fs_ci.c -lm

verify-fuzz: fuzz
ifeq ($(PX_DATA),1)
	@for s in 1 2 3; do ./fuzz $(DATA) $$s 400 /tmp/opencode || exit 1; done
else
	@echo "verify-fuzz: SKIP (no game data DATA=$(DATA); the hermetic corpus fuzz/in stays covered by the fuzz build)"
endif

# T-17: per-user save/config dir + one-time legacy import. The game
# resolves STATUS.LEO in LEO_USER_DIR (an override for $LEO_USER_DIR),
# importing a DATA-adjacent copy EXACTLY once (byte-identical, original
# untouched), and LEO_SAVE still wins verbatim. Hermetic: a copy of the
# binary next to a temp data dir so that dir is the auto-detected DATA.
verify-userdir: ll_cutscene
ifeq ($(PX_HD),1)
	@if [ ! -f $(HD)/STATUS.LEO ]; then echo "verify-userdir: SKIP (no $(HD)/STATUS.LEO)"; exit 0; fi
	@T=$$(mktemp -d /tmp/opencode/t17.XXXXXX); \
	cp ll_cutscene $$T/; mkdir -p $$T/data $$T/user; \
	cp $(HD)/STATUS.LEO $$T/data/; : > $$T/data/ANIMACJE; : > $$T/data/ETAPY; \
	run() { env -u DISPLAY -u WAYLAND_DISPLAY SDL_VIDEODRIVER=dummy \
	        LEO_USER_DIR=$$T/user $$T/ll_cutscene /no.is 2>&1; }; \
	run | grep -q 'imported legacy save into user dir' \
	  || { echo "verify-userdir: first run did not import"; exit 1; }; \
	cmp -s $$T/data/STATUS.LEO $$T/user/STATUS.LEO \
	  || { echo "verify-userdir: imported save not byte-identical"; exit 1; }; \
	test -f $$T/data/STATUS.LEO \
	  || { echo "verify-userdir: original DATA save was moved, not copied"; exit 1; }; \
	run | grep -q 'imported legacy' \
	  && { echo "verify-userdir: imported a second time"; exit 1; }; \
	env -u DISPLAY -u WAYLAND_DISPLAY SDL_VIDEODRIVER=dummy \
	  LEO_SAVE=$(HD)/STATUS.LEO LEO_USER_DIR=$$T/user $$T/ll_cutscene /no.is 2>&1 \
	  | grep -q 'STATUS.LEO: 75 words' \
	  || { echo "verify-userdir: LEO_SAVE override broken"; exit 1; }; \
	rm -rf $$T; echo "verify-userdir: user-dir import-once + byte-identical + LEO_SAVE override (ok)"
else
	@echo "verify-userdir: SKIP (no $(HD)/STATUS.LEO; see the restaging recipe in NEXT_STEPS.md"
endif

# T-20 CMake parity check: the alternate build must produce the same
# game. Skips cleanly when cmake isn't installed (the Makefile stays
# the reference build either way).
verify-cmake: py-refs
ifeq ($(PX_CMAKE),)
	@echo "verify-cmake: SKIP (no cmake installed)"
else
ifeq ($(PX_DATA),)
	@echo "verify-cmake: SKIP byte-exactness halves (no $(DATA)/INTRO_P.IS) - building BOTH cmake targets as the build-parity check"
	$(RM) -r /tmp/opencode/cmbuild /tmp/opencode/cmwin
	cmake -B /tmp/opencode/cmbuild -S . >/dev/null && cmake --build /tmp/opencode/cmbuild -j >/dev/null && echo "  cmake linux build: ok"
	if [ -d '$(SDL_WIN)' ]; then PKG_CONFIG_LIBDIR=$(SDL_WIN)/lib/pkgconfig cmake -B /tmp/opencode/cmwin -S . -DCMAKE_TOOLCHAIN_FILE=cmake/toolchain-mingw-x86_64.cmake >/dev/null && cmake --build /tmp/opencode/cmwin -j >/dev/null && echo "  cmake windows cross-build: ok"; else echo "  cmake windows cross-build: SKIP (vendored SDL2 absent at $(SDL_WIN), gitignored on purpose; the Makefile win target still cross-builds with the system toolchain)"; fi
else
	$(RM) -r /tmp/opencode/cmbuild /tmp/opencode/cmwin
	cmake -B /tmp/opencode/cmbuild -S . >/dev/null && cmake --build /tmp/opencode/cmbuild -j >/dev/null
	/tmp/opencode/cmbuild/ll_cutscene $(DATA)/INTRO_P.IS --ppm 1020 /tmp/opencode/cm_f1020.ppm
	cmp /tmp/opencode/cm_f1020.ppm /tmp/opencode/c_py/f01020.ppm \
	  && echo "cmake linux binary == python reference (byte-exact)"
	PKG_CONFIG_LIBDIR=$(SDL_WIN)/lib/pkgconfig cmake -B /tmp/opencode/cmwin -S . \
	  -DCMAKE_TOOLCHAIN_FILE=cmake/toolchain-mingw-x86_64.cmake >/dev/null \
	&& cmake --build /tmp/opencode/cmwin -j >/dev/null
	cp $(SDL_WIN)/bin/SDL2.dll /tmp/opencode/cmwin/ 2>/dev/null || true
	env -u DISPLAY WINEPREFIX=$(WINEPREFIX) WINEDEBUG=-all \
	  wine /tmp/opencode/cmwin/ll_cutscene.exe Z:$(DATA)/INTRO_P.IS \
	  --ppm 1020 Z:/tmp/opencode/cm_win.ppm
	cmp /tmp/opencode/cm_win.ppm /tmp/opencode/c_py/f01020.ppm \
	  && echo "cmake windows binary (+SDL2.dll) == python reference (byte-exact)"
endif
endif

# T-01 end-state structural pin (free of compiling): ONLY the backend
# and its private helpers may include SDL. Engine screens, the app glue
# and the shared codecs must reach the platform only via platform.h.
# If any other file grows an SDL include back (regression of PR-15..18),
# this leg fails with the offending file named.
verify-arch:
	@bad=$$(grep -rlE "include[[:space:]]*[<\"]SDL" ported/ | grep -vE \
	    '^ported/(platform_sdl\.c|platform_sdl/|ll_view\.h|ll_audio\.h)'); \
	if [ -n "$$bad" ]; then printf 'engine SDL-free pin FAILED:\n  %s\n' \
	    $$bad; exit 1; fi; \
	leak=$$(grep -rlE "include[[:space:]]*\"(ll_view|ll_audio)\.h\"" ported/ \
	    | grep -vE '^ported/(platform_sdl\.c|platform_sdl/|ll_view\.[ch]|ll_audio\.[ch])'); \
	if [ -n "$$leak" ]; then printf 'SDL-carrying header pulled into the engine:\n  %s\n' \
	    $$leak; exit 1; fi; \
	echo "T-01 structure: engine+app SDL-free, backend only (ok)"

# PR-195: THE ENGINE-DOCUMENTATION STRUCTURE PIN (tools/doc_census.py,
# the owner's 2026-11-19 documentation audit). It reads only the tracked
# markdown, so like verify-arch and stage_selftest it runs in EVERY
# configuration - fixtures or not. Four rules; the rest it only reports:
#   P1 every record heading is found (a `## PR-<n>` heading followed by a
#     space or `(`), the count never falls below the recorded floor, and
#     every PR number up to the newest one either has a record or is in
#     the tool's frozen accepted-gap list (PR-1..6 predate the record
#     convention, 22/23/24 live inside the old status block, PR-80
#     inside PR-79's record, PR-113 has none).
#   P2 the `## Next`, `## Deferred big items` and `## Standing rules`
#     sections of NEXT_STEPS.md appear exactly once each.
#   P3 the over-79-column ratchet (71 / 71 / 12 for NEXT_STEPS /
#     HANDOFF / README, the state this audit measured). Raising one
#     fails the build until a commit says why; that is the hand-check
#     "the over-79 line set did not move", made automatic.
#   P4 (PR-196) the record template: every record numbered 196 or
#     higher carries the HANDOFF section 10a field block - ten fields,
#     the gate in two lines, each present once at column 0 in order.
#     PR-196 itself is the one exemption; a partial block fails every
#     other record.
# P1 is also what replaces the hand census `grep -c '^## PR-1'`, a
# PREFIX PROXY: it sees 107 of the 184 records (the 74 older records and
# the 4 OWNER records are invisible to it).
verify-docs:
	@python3 tools/doc_census.py

# PR-197: the generated engine index (docs/RE_INDEX.md) is pinned by
# regeneration + cmp, so the index cannot drift from the ledger. Like
# verify-docs it reads only tracked markdown, so it runs in EVERY
# configuration (fixtures or not) and adds exactly one (ok) line.
verify-index:
	@tmp=$$(mktemp); python3 tools/re_index.py "$$tmp" || exit 1; \
	cmp "$$tmp" docs/RE_INDEX.md || { echo 'index: FAILED docs/RE_INDEX.md is stale; run: python3 tools/re_index.py docs/RE_INDEX.md' >&2; rm -f "$$tmp"; exit 1; }; rm -f "$$tmp"; \
	echo "index: docs/RE_INDEX.md regenerates byte-identical (ok)"

# T-24 golden-master (PLAN S6 rig, no-CD route). The ORIGINAL game runs in
# QEMU (MS-DOS 6.22 floppy + build_data_disk.sh HDD + CFG drive 'C' + the
# known 0x5bd51 CD-gate bypass on a COPY, see build_data_disk.sh header);
# its chapter-map menu is a STATIC frame (40:6C frozen - the detector
# golden_qemu_run.py uses), so
# frames need no tick alignment: the port's animation poses are scanned
# against it by golden_menu_cmp.py. Fixtures are user-supplied and never
# in git; frames stay in /tmp - the repo stores hashes only.
#   make golden_rig   rebuilds images + capture (~5 min, needs LL.iso,
#                     an MS-DOS 6.22 boot disk image, qemu, mtools)
#   make golden_rig_cd  SAME capture on the CD-ATTACHED rig: the only
#                     configuration the ORIGINAL is known to reach the
#                     chapter map menu in (PLAN S6/hunt9-13; the no-CD
#                     route stayed in its movie loop through 1500 s of
#                     0.25 s-sampled attract, 2026-11-15). -cdrom LL.iso +
#                     a real-mode ATAPI CD driver + MSCDEX on the floppy
#                     (the S6 "-cdrom+UDVD2/MSCDEX rig with the 0x5bd51
#                     patch instead of the ASPI-dependent NOP"). The CD
#                     exists only inside the emulator running the ORIGINAL;
#                     the PORT itself remains fully no-CD.
#   make golden_rig_ddir the DISK-D control: no CD anywhere in the rig.
#                     D: is a second virtual disk with a plain FAT \LEO\
#                     (no MSCDEX, no driver - the user rule: data loads
#                     from a directory, no mounting). If the map menu
#                     appears here too, the original's gate is the PATH,
#                     not the CD medium - and the golden capture runs on a
#                     CD-free rig end to end.
GOLDEN     ?= /tmp/opencode/golden
GOLDEN_MIN ?= 99   # full-compare floor (PR-54: 99.57% best after the map drew
                   # the data-mapped arrow + title only; was 90 at 92.46%).
                   # History - PR-40: PR-40 re-measure 90.7281% best /
                   # 90.7188% worst pose. The -1.7pt drop from PR-37's
                   # 92.4516% IS the reconstructed BERLO mace sprite
                   # (~1600 px) drawn at the selection park: the
                   # captures prove the original's mace never moves
                   # (baked into BACK.PCX), so the owner-requested
                   # moving red cursor must cost match vs one fixed
                   # capture. PR-23's 98.43% was measured against the
                   # captured screenshot as base; the base is now the
                   # engine's own BACK.PCX + port-drawn text, so the
                   # residual is the font style (PR-37 cursive-font
                   # candidate closes it).
# raise toward 99.9 as the composed texts/overlays converge
ISO        ?= LL.iso
MSDOS622   ?= /tmp/opencode/msdos622_x/dos-622-disk1.img
CDDRV      ?= /tmp/opencode/oakcdrom.sys

golden_rig:
	@ISO=$(ISO) MSDOS622=$(MSDOS622) GOLDEN=$(GOLDEN) \
	    bash tools/golden_build_rig.sh
	@python3 tools/golden_qemu_run.py --workdir $(GOLDEN) --timeout 1800

golden_rig_cd:
	@ISO=$(ISO) MSDOS622=$(MSDOS622) GOLDEN=$(GOLDEN) CD=1 CDDRV=$(CDDRV) \
	    bash tools/golden_build_rig.sh
	@python3 tools/golden_qemu_run.py --workdir $(GOLDEN) --cdrom $(ISO) \
	    --frame-interval 0.3 --sendkey-at "30=esc" --want-art --timeout 120

golden_rig_ddir:
	@ISO=$(ISO) MSDOS622=$(MSDOS622) GOLDEN=$(GOLDEN) DDIR=1 \
	    bash tools/golden_build_rig.sh
	@python3 tools/golden_qemu_run.py --workdir $(GOLDEN) \
	    --ddisk $(GOLDEN)/leo_d.qcow2 --frame-interval 0.3 \
	    --sendkey-at "30=esc" --want-art --timeout 120

verify-golden: py-refs ll_cutscene
ifeq ($(PX_DATA),1)
	@mkdir -p $(GOLDEN)/port_frames; rm -f $(GOLDEN)/port_frames/map_*.ppm
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_SECS=4 \
	    LEO_MENU_PPM_DIR=$(GOLDEN)/port_frames LEO_MENU_PPM_MAX=300 \
	    timeout 120 ./ll_cutscene --demo $(DATA) >/dev/null 2>&1 || true
	@python3 tools/golden_menu_cmp.py --port-dir $(GOLDEN)/port_frames \
	    --expect tools/golden_expect.json --json $(GOLDEN)/cmp.json
	@if [ -f $(GOLDEN)/vram.bin ] && { [ -f $(GOLDEN)/menu_art.ppm ] \
	    || [ -f $(GOLDEN)/menu.ppm ]; }; then \
	    SCREEN=$$( [ -f $(GOLDEN)/menu_art.ppm ] && echo menu_art.ppm \
	        || echo menu.ppm ); \
	    python3 tools/golden_menu_cmp.py --vram $(GOLDEN)/vram.bin \
	        --screen $(GOLDEN)/$$SCREEN \
	        --port-dir $(GOLDEN)/port_frames \
	        --expect tools/golden_expect.json --json $(GOLDEN)/cmp.json \
	        --min-match $(GOLDEN_MIN); \
	else \
	    echo "golden-master: original capture absent (run: make golden_rig); "\
	        "checked port pins only"; \
	fi
else
	@echo "verify-golden: SKIP (the port pose-dump half needs game data $(DATA); without a pose dump the golden contract cannot be exercised)"
endif

# ---------------------------------------------------------------------------
# OWNER RULING 2026-11-19 (recorded in HANDOFF.md section 2 rule 8): the
# day-to-day gate is the LINUX suite. The Windows version is not tested
# during implementation; it is tested ONCE, at the end of implementation,
# as `make -k verify-windows` (below). Nothing is deleted - the legs and the
# .exe rules stay exactly as they were, they are just out of the loop.
#
# Measured reason (2026-11-19, fixtures staged, per-leg wall times, all
# legs EXIT=0): the full suite is 307 s and verify-win alone is 164.8 s -
# 53.7% of it - because it is 23 cold wine starts plus five replays of the
# same menu/movie chain. The remaining 22 legs sum to ~142 s and are
# mutually independent. Porting risk lives in the shared C code, which the
# Linux legs already cover end to end; the Windows legs prove the same code
# builds and runs on the second target, which is a build-target question and
# does not change while the port changes.
#
# Not yet switched off (stated honestly): the wine/.exe HALVES inside the
# mixed legs (verify-skip, verify-music, verify-menu, verify-pcm,
# verify-help, verify-cmake) still run as part of verify-all. They are the
# next candidates; the end-of-implementation pass runs them either way.
#
# The Linux suite is also run IN PARALLEL, and that is safe: `make -k
# -j"$(nproc)" verify-all`. Measured 2026-11-19: serial 124-159 s, -j22
# 29-40 s, -j4 38 s, all rc=0 over identical 93-verdict sets. The legs'
# scratch paths are disjoint (the one shared file is the read-only py-refs
# oracle frame, built by a prerequisite). Do NOT parallelise the Windows
# half: verify-win and verify-mod share one WINEPREFIX.
#
# WINTEST=1 puts the Windows legs back into verify-all for anyone who wants
# the single old command: `make -k verify-all WINTEST=1` == the pre-2026-11-19
# gate, byte for byte.
ifeq ($(WINTEST),1)
  WIN_LEGS := verify-win verify-mod
else
  WIN_LEGS :=
endif

verify-all: verify verify-is-synth verify-skip verify-llrs verify-pcx \
            verify-seq verify-pcm verify-level verify-play verify-help \
            verify-menu verify-sel verify-quit verify-save verify-music \
            verify-utf8 verify-fuzz verify-platform verify-userdir \
            verify-stage verify-endlevel \
            verify-arch verify-docs verify-index verify-golden \
            verify-cmake $(WIN_LEGS)
	@echo "ALL TESTS PASSED (linux half; Windows legs are deferred by the"
	@echo "2026-11-19 ruling - the end pass is 'make -k verify-windows')"

# The end-of-implementation Windows pass. One command, the complete old
# suite: cross-build parity + everything proven under wine.
verify-windows: verify-win verify-mod
	@echo "WINDOWS PASS OK (verify-win + verify-mod; build 'make win' too)"

verify-all-windows: verify-all verify-windows
	@echo "FULL SUITE OK (linux + windows + llrs)"

clean:
	rm -rf dist
	rm -f ll_cutscene ll_cutscene.exe llrs_selftest llrs_selftest.exe fuzz \
	      platform_selftest \
	      resources/ll_cutscene.res \
	      pcx_selftest pcx_selftest.exe seq_selftest seq_selftest.exe \
	      seq_patchdump seq_patchdump.exe seq_shapedump seq_shapedump.exe pcm_selftest pcm_selftest.exe \
	      mod_selftest mod_selftest.exe ll_level ll_level.exe \
	      ll_save ll_save.exe stage_selftest stage_selftest.exe \
	      endlevel_census endlevel_census.exe *.o *.obj

.PHONY: py-refs verify-is-synth run win verify verify-skip verify-win verify-llrs verify-pcx \
        verify-seq verify-pcm verify-mod verify-level verify-play verify-help verify-menu \
        verify-sel verify-quit verify-save verify-music verify-utf8 verify-fuzz \
        verify-platform verify-userdir verify-cmake verify-all verify-windows \
        verify-all-windows level clean package package-win package-linux \
        verify-golden verify-arch verify-stage verify-endlevel verify-docs \
        verify-index golden_rig golden_rig_cd golden_rig_ddir
