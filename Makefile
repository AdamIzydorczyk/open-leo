	         /tmp/opencode/ly_chang.log \
	  && grep -q 'play tick 262: state A_PODCIAG seq lift frame 1 pos 204,483 grounded 1' \
	         /tmp/opencode/ly_chang.log \
	  && grep -q 'play: A_PODCIAG -> A_DRAP' /tmp/opencode/ly_chang.log \
