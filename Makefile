	@echo "verify-pcx: SKIP (needs $(DATA)/ETAPY/1/BACK000.PCX; see the restaging recipe in NEXT_STEPS.md"
endif

# ported/ll_seq.c byte-for-byte agreement with tools/seq_parse.py on every
