# PR-526: THE LEVEL ENDS BY ITS OWN LION CLASS'S RULE - the dive.
# ZARIA1.DES names the lion class in its OWN text (`lew=TLewZaria,`),
# and the level-session open 0x4dde0 tries that name against a factory
# chain - 0x1fef0 answers 'TLewZaria' (alloc 0x12e, class
# 0x96960 installed at [obj+0x8]) - and stores the winner at
# [session+0x394]. The level loop's FIRST top-of-iteration guard reads
# [[ecx+0x394]+0x116] (0x4ac3b-0x4ac50): nonzero is loop code 3, and
# the caller's 0x5d3c6-0x5d3d7 leg runs the reset pair 0x5da60/0x5d050
# and CONTINUES (eax=1 at 0x5d3dc) - the stage re-enters. Who raises
# [obj+0x116]? Every transition pass calls the object class's +0x90
# verb: 0x53520 copies the iteration's EventSet [obj+0x60]
# (0x53536-0x53557), matches the state's transition list against that
# copy (0x5356b, 0x52000), then calls [class+0x90] (0x5357d) BEFORE
# the applier 0x535a0 writes the next state into [obj+0x5c] (the
# write is 0x535ed) - and only then zeroes [obj+0x60] through
# 0x749a0(eax=[obj+0x60], ebx=0xc, edx=0) at 0x5358e. ZARIA's slot
# (dword 0x1e250 at 0x969f0 = class+0x90) sets [obj+0x116]=1 exactly
# when [obj+0x5c] == 9 - A_WPAD, the tenth name in ZARIA's OWN
# declared state table - and bit 2 of [obj+0x60], the AC_BREAK_NEXT
# the row walk itself armed at 0x521c1 (`orb BYTE [ebp],4` on the
# last-row step), is live. So in ZARIA there is NO end_level row and
# no A_EXIT: the level ends when the lion's wet animation list WRAPS -
# the dive into the water IS the level end, and the loop restarts the
# stage. (The base lion's +0x90 arm 0x3d940 raises nothing, and
# TLewZariaB's 0x1e350 has no such arm - it CANCELS a request for state
# index 9 unless the level word ds:0xcef64 is set, and never writes
# +0x116: the rule belongs to the named class, nothing else. That same
# verb is also the level's state-request FILTER, counted here and not
# ported: the word it tests is the request pair 0x536f0 builds at
# 0x53736 and 0x535a0 applies, so `cmpl $4` is a request for index 4 =
# A_JUMP_S and `cmpl $0xa` one for A_KILOF (energy [obj+0xad] -30),
# and 0x1e2dc cancels an A_JUMP_DOWN/A_KAMIEN request when the level
# words ds:0xcef64/ds:0xcef68 say so. The message side, also counted:
# ZARIA's own +0x10 verb 0x1e130 does NOT delegate to the base handler
# for type 0xc - at 0x1e146 it arms the one-shot [obj+0x12a]=1, and on
# the next state-request pass 0x1e288 rewrites that request to index 9
# = A_WPAD while 0x1e27f skips this end check once. So ZARIA has its
# own way of putting the lion into the water, and the port has no
# message queue that could run it: OI-053. The base lion's own +0x10
# handler 0x50d60 does have a raiser of its own - the 0x50d9c arm
# `movl $1,[obj+0x116]` reached through its table at 0x50d20
# (PR-483's kind-0xc/pause word) - and ZARIA's class replaces it.)
# THE LEG (test hook LEO_PLAY_STATE, named in README): no key, then
# A_WPAD is entered at tick 5 - its authored entries (LEW.MOV lines
# 53/78/105/131/219) all ask AC_ONAIR,AC_DRECT. That gate DOES have
# shipped data - ZARIA.01 authors the one DRECT box in the placement
# text, `DRECT,988,645;1340,750`, and the port's own
# rect_class_answer raises AC_DRECT for a falling player inside it
# (counted at OI-018) - but that box is at x 988..1340, the far east
# end of the level, and no shipped leg walks that far, so the state
# cannot be entered from the keys in a leg yet; the hook mirrors a
# matched transition's applier exactly (row 1 current, both feeds
# zeroed). DERIVED on the authored A_WPAD
# rows - TEN of them, `1,200,lock`, `2,200,smpauto`, `3,200`, `4,200`,
# `6,200` ... `11,200,unlock`, each carrying its own threshold 200 -
# on PR-110's clock (100 a row-unit, so one row per two ticks): the
# entry tick's row pass feeds 100 and no row closes, row 1 closes at
# tick 6, and one row per two ticks after, so the tenth row
# (`11,200,unlock`, the frame the log shows as 11 - the frame field is
# the AUTHORED frame number, and this list has no frame 5) is current
# at tick 22. The next close, at tick 24, is the LIST WRAP (fi + 1 >=
# nfr at the PR-323 step: fi := 0, the wrap bit armed), which is why
# the log shows frame 1 again at 24. Tick 25 is where both halves of
# the engine's sequence live on one pass: the class's 0x1e250 arm
# raises the flag at 0x5357d, and the authored
# `A_WYJSCIE(1)=AC_BREAK_NEXT` transition still matches and is still
# applied (0x535a0 - the end request does NOT suppress the state
# change). At tick 26's TOP the loop's first guard sees the flag and
# takes code 3, and the port's stage_apply re-enters: no play line
# runs at 26 (the guard `continue`s, exactly as the engine's caller
# re-enters before the next iteration), and play_spawn has put the
# lion back at the authored pozycja - x 50, ZARIA_A.PLT line 1
# `1 -50,680!408,684` at x 50 gives 680, minus the WALK art's
# documented 32 px (PR-97) = 50,648 grounded, A_WALK from its
# declared first name at its authored row 1 = frame 10, held there
# with no key (the BY_X law PR-83 pins). The dry state's single tick
# is pinned to NOT continue: the reset takes the stage first.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:NONE" LEO_PLAY_STATE="5:A_WPAD" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_dive.ppm LEO_LEVEL_PPM_TICK=40 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_dive.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA dive-end FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_dive.log; exit 1; fi
	@grep -q 'play state injection: tick 5: A_WPAD' /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 6: state A_WPAD seq wet frame 2' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 8: state A_WPAD seq wet frame 3' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 22: state A_WPAD seq wet frame 11' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 24: state A_WPAD seq wet frame 1' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'play: A_WPAD -> A_WYJSCIE' /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 25: state A_WYJSCIE seq dry' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'stage driver: exit 3 at tick 25: RESET to the authored' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'end-request flag (0x1e250 -> \[obj+0x116\]=1) was read' \
	         /tmp/opencode/ly_dive.log \
	  && ! grep -q 'play tick 26: state' /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 27: state A_WALK seq walk frame 10 pos 50,648 grounded 1' \
	         /tmp/opencode/ly_dive.log \
	  && grep -q 'play tick 40: state A_WALK seq walk frame 10 pos 50,648 grounded 1' \
	         /tmp/opencode/ly_dive.log \
	  && ! grep -q 'play: A_WYJSCIE -> A_DRAP' /tmp/opencode/ly_dive.log \
	  && [ "$$(grep -c 'exit 3 at tick' /tmp/opencode/ly_dive.log)" = 1 ] \
	  && echo "play dive-end (PR-526): the level's own lion class ends" \
	     "the stage - LEO_PLAY_STATE enters the authored A_WPAD, its" \
	     "ten T=200 rows admit one per two ticks (row 11 current at" \
	     "22), the list wraps at 24 arming the bit, and at 25 the" \
	     "transition pass runs the authored A_WYJSCIE row AND the" \
	     "class's 0x1e250 arm raises [obj+0x116]; at 26 the loop's" \
	     "FIRST guard (0x4ac3b, before the end_level slot) takes code" \
	     "3 and the stage re-enters at the authored spawn 50,648 -" \
	     "ZARIA has no end_level row and needs none: the dive IS the" \
	     "level end (ok)" \
	  || { echo "play ZARIA dive-end grep FAILED"; \
	       grep -E 'play: A_|state A_(WPAD|WYJSCIE|WALK) |stage driver' \
	         /tmp/opencode/ly_dive.log | tail -16; exit 1; }
# PR-83: the KEYUP half of the input contract. No backend ever translated
# SDL_KEYUP, so through the REAL backend every key stuck down forever: the
# reported "controls press themselves in a loop". The live loop (NO
# LEO_LEVEL_PPM: the fixed-grid legs bypass platform_poll, which is why
# this bug was invisible to them) drives one key through the SDL event
# queue - LEO_TEST_KEY at 50 ms, LEO_TEST_KEY_UP_AFTER_MS release at
# 1300 ms - and pins BOTH edges: A_STAY -> A_WALK_FWD on press,
# A_WALK_FWD -> A_STAY on release.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2.2 \
	  LEO_TEST_KEY=right LEO_TEST_KEY_AFTER_MS=50 LEO_TEST_KEY_UP_AFTER_MS=1300 \
	  timeout 10 ./ll_level $(DATA) RAN.01 --play --no-audio \
	  > /tmp/opencode/ly_keyup.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play key release FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_keyup.log; exit 1; fi
	@grep -q 'play: A_STAY -> A_WALK_FWD' /tmp/opencode/ly_keyup.log \
	  && grep -q 'play: A_WALK_FWD -> A_STAY' /tmp/opencode/ly_keyup.log \
	  && test "$$(grep -c '> A_WALK_FWD' /tmp/opencode/ly_keyup.log)" -eq 1 \
	  && echo "play key release: a real SDL_KEYUP stops the walk (A_WALK_FWD -> A_STAY through !K_FWD) - the reported sticky-input loop is gone (ok)" \
	  || { echo "play key release grep FAILED"; cat /tmp/opencode/ly_keyup.log; exit 1; }
# the SAME runtime on the other level blocks that carry complete player
# sets (inventory measured 2026-11-16 over the full CD + HD-install
# trees: 12 of 13 run their own LEW.* art + .MOV + their own ground;
# the ground is a .PLT for most and a sub-.des for two - see the leg
# below. KADMAR.07's lion lives in an ANIMACJE leaf literally named
# "0", which its .des names exactly, so it runs too).
# ENA.03 additionally pins the '!' point-separator variant (ENA.PLT) on
# real bytes: without it that ground parsed to zero lines.
	@for L in ENA.03 ENA2 KARA.07 KADMAR.07 KADMAR2 LONA.05 ZARIA.01 ZARIA.02; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_multi_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=12 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_multi_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play multi-level $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; fi; \
	  grep -qE 'play: [A-Za-z0-9_.]+ [0-9]+ state\(s\) on [0-9]+ polyline' \
	      /tmp/opencode/ly_multi_$$L.log || { echo "play multi-level $$L not wired"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; }; \
	  grep -qE 'play tick 12: state A_' /tmp/opencode/ly_multi_$$L.log || \
	    { echo "play multi-level $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: ENA.PLT: 1 polyline' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'spawn feet (100,538) grounded=1' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'play tick 12: state A_SWIM' /tmp/opencode/ly_multi_ENA.03.log \
	  && echo "play multi-level: 8 more levels run their OWN lion data (zero special-casing); ENA.PLT '!' separator + the ENA.03 A_SWIM state prove the extended grammar on real bytes" \
	  || { echo "play multi-level ENA.03 grep FAILED"; cat /tmp/opencode/ly_multi_ENA.03.log; exit 1; }
# PR-44: the SECOND real form of `platformy=`. Two level blocks point it
# at a sub-.des of their own block instead of a .PLT, and that record's
# TEXT is the very same polyline grammar (count header and all): TUNGA2.12
# and SADES.06 say platf.des, whose PLATF.DES record starts
# "66\r\n1 1495,147;..." / "8\r\n1 863,166;...". Same parser, so these
# two levels run their own lion on their own ground - no special casing.
	@for L in TUNGA2.12 SADES.06; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_desground_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=12 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_desground_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ground-from-.des $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; fi; \
	  grep -q 'play: PLATF.DES: [0-9]* polyline' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: ground not read"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; }; \
	  grep -qE 'spawn feet \([0-9]+,[0-9]+\) grounded=1' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: spawn not snapped on it"; exit 1; }; \
	  grep -qE 'play tick 12: state A_' /tmp/opencode/ly_desground_$$L.log || \
	    { echo "play ground-from-.des $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: PLATF.DES: 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'LEW.TUN 33 state(s) on 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'spawn feet (50,290) grounded=1' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'play: PLATF.DES: 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'LEW.SAD 37 state(s) on 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'spawn feet (20,138) grounded=1' /tmp/opencode/ly_desground_SADES.06.log \
	  && echo "play ground-from-.des: platformy= has TWO real forms (a .PLT, or a sub-.des holding the same polylines) - both levels now run their own lion on their own ground" \
	  || { echo "play ground-from-.des exact-count grep FAILED"; \
	    cat /tmp/opencode/ly_desground_TUNGA2.12.log /tmp/opencode/ly_desground_SADES.06.log; \
	    exit 1; }
# ...and the THIRD answer a level can give: JUNCTION says platformy=none.des
# and its NONE.DES record is literally "0". That is an AUTHORED empty
# ground (the level has no floor), not a missing file, so it must print as
# "has NO ground in its own data" and never as the "lacks"/"no .PLT" data
# hole. Same rule for the bare `none` keyword in the other .des lists
# (JUNCTION animacje=none, RAN.01 zwierzaki=...,none): it means "nothing
# here", so no false 'not in the HD level block (data hole)' note and no
# invented placements from the fallback scan.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_PLAY_SCRIPT="1:FWD" LEO_LEVEL_PPM=/tmp/opencode/ly_noground.ppm \
	  LEO_LEVEL_PPM_TICK=12 \
	  ./ll_level $(DATA) JUNCTION --play --no-audio \
	  > /tmp/opencode/ly_noground.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play JUNCTION authored-empty FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_noground.log; exit 1; fi
	@grep -q 'play: NONE.DES: 0 polyline' /tmp/opencode/ly_noground.log \
	  && grep -q 'has NO ground in its own data' /tmp/opencode/ly_noground.log \
	  && grep -q 'authored scene JUNCTION: 0 placement file(s), 0 object' \
	      /tmp/opencode/ly_noground.log \
	  && ! grep -q 'lacks ground' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'not in the HD level block' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'll_level: placement' /tmp/opencode/ly_noground.log \
	  && echo "play authored-empty ground: platformy=none.des = '0' is DATA (no floor), reported as such, and the bare 'none' keyword is never a fake data hole" \
	  || { echo "play authored-empty ground grep FAILED"; cat /tmp/opencode/ly_noground.log; \
	    exit 1; }
# per-level data: TUNGA.11 has its OWN complete player set (LEW.TUN art,
# 36-state LEW.MOV, TUNGA.PLT 7 lines, lew_rect -100..1570) - the runtime
# is generic, the level data drives everything.
# PR-83 re-pinned the spawn half: the lion starts in the .MOV's DECLARED
# first state (A_WALK here, A_SWIM on ENA.03) - the egg intro is NOT a
# spawn state: [A_DRAP] reaches A_GIVE_EGG only via K_FIRE,K_F6, and the
# block-0 start that showed it at spawn was a model artifact (the 0021
# art is still loaded, by the egg's own placement).
# PR-110 re-pinned the frame number; PR-135 re-pinned it on the
# iteration grid; PR-256 re-derives it on the integer register; PR-523
# re-pins it on the row-admit gait, and every number below is still
# arithmetic from the shipped [A_WALK] (TUNGA's own LEW.MOV, pulled out
# of ANIMACJE/TUNGA.11/LEW.TUN/LEW.MOV for this leg): BY_X,
# F=100,0 T=20,5 G=30,350 - the same x words as ZARIA's - over the
# row list `10,6 / 11,6 / 12,6 / 1,6 / 2,6 / 3,6 ...`, one frame per 6
# px of travelled distance, frames in the authored order 10,11,12,1,...
#  - PASS 1 IS THE INTENT EDGE (PR-523's seed). Drag on 0 is 0, the
#    add is idiv(F*s,20) + G_x*facing = idiv(100*20,20) + 30 = 130, so
#    the register is 130 raw (the log's v 2600) and the step
#    idiv(130,100) = 1 px: 51 at tick 1, frame 10, the list's entry.
#  - THEN THE WALK FEEDS ITS OWN ROWS. Between passes the BY_X feed is
#    the persisted step word (PR-518), so 1 a tick against a 6-unit
#    threshold: the accumulator reaches 6 at tick 7, and pass 2 is
#    130 - idiv(130*20,100) + 130 = 234 raw, step 2 px, x 53, list
#    index 1 = frame 11.
#  - AND THE LADDER SELF-ACCELERATES. The threshold is consumed at the
#    admit, so the next row needs 6 more units at the NEW step word:
#    feed 2, 2, 2 admits at 10 (v 318, x 56, frame 12), feed 3, 3
#    admits at 12. The arithmetic is exactly the closed form of
#    v -> v - idiv(v*20,100) + 130: 130, 234, 318, 385 (logs as
#    v 2600, 4680, 6360, 7700), steps 1, 2, 3, 3 px, x 51, 53, 56,
#    59 - 9 px travelled by tick 12. The y follows TUNGA.PLT's own 7th
#    line (that record's `1 13,405;67,400`, read from the HD ETAPY
#    level block): the interpolation floors to 401 up to x 56 and to
#    400 from x 57, and with this pose's art contact that is feet 370
#    then 369 - the same line the old pin stood on at x 65.
#  - SO TICK 12 DRAWS LIST INDEX 3, FRAME 1 - three frames of the
#    cycle, because three rows admitted. The walk rate and the frame
#    rate are ONE quantity here: PR-522's cold-start reading in
#    reverse, the gait settles where the 130 add meets the 20% drag,
#    raw 650 = a 6 px step, and at 6 px a pass the feed is exactly one
#    row a pass, so the 12-frame cycle then runs at one frame per 6 px.
# The old pins (frame 11 at tick 30, frame 2 before PR-110, frame 12
# with 15 px at tick 12) were the ms clock cycling that list.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD" LEO_LEVEL_PPM=/tmp/opencode/ly_tun.ppm \
	  LEO_LEVEL_PPM_TICK=12 \
	  ./ll_level $(DATA) TUNGA.11 --play --no-audio \
	  > /tmp/opencode/ly_tun.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play TUNGA.11 FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_tun.log; exit 1; fi
	@grep -q 'play: art LEW.TUN/0021.SEQ: 10 element' /tmp/opencode/ly_tun.log \
	  && grep -q 'play: TUNGA.PLT: 7 polyline' /tmp/opencode/ly_tun.log \
	  && grep -q 'spawn feet (50,370) grounded=1 bounds -100..1570' \
	      /tmp/opencode/ly_tun.log \
	  && grep -q 'play tick 1: state A_WALK seq 0003 frame 10 pos 51,370 grounded 1 v 2600,0' \
	      /tmp/opencode/ly_tun.log \
	  && grep -q 'play tick 7: state A_WALK seq 0003 frame 11 pos 53,370 grounded 1 v 4680,0' \
	      /tmp/opencode/ly_tun.log \
	  && grep -q 'play tick 10: state A_WALK seq 0003 frame 12 pos 56,370 grounded 1 v 6360,0' \
	      /tmp/opencode/ly_tun.log \
	  && grep -q 'play tick 12: state A_WALK seq 0003 frame 1 pos 59,369 grounded 1 v 7700,0' \
	      /tmp/opencode/ly_tun.log \
	  && echo "play per-level: TUNGA.11 LEW.TUN set spawns in its declared A_WALK and walks its own .plt/bounds on FWD - the intent-edge pass, then one pass per 6 px of its own row feed (130, 234, 318, 385 raw), so the frame rate and the walk rate are one quantity (no level special-casing in code)" \
	  || { echo "play TUNGA.11 grep FAILED"; cat /tmp/opencode/ly_tun.log; exit 1; }
else
	@echo "verify-play: SKIP data legs (needs $(DATA) + LEO_HD_DIR fixtures; see NEXT_STEPS.md)"
endif

# Level help overlay (POMOC flow): HD .MNU page list + CD ETAPY .SEQ page
# art. JUNCTION carries page art AND the whole scene is one .PCX, so the
# help frame dump must be the bare bg plus exactly the page-0 window
# (element anchor (-f0,-f2)), with a pixel count matching the python oracle.
verify-help: ll_level llrs_selftest
ifeq ($(PX_DATA),1)
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
