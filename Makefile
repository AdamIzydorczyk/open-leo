# PR-87: the fire-family keys + comma-group AND semantics on REAL data.
# ZARIA's attack entry is literally `A_FIGHT(1)=K_FIRE,K_F1` ("fire
# WHILE weapon 1 is selected" - the AND reading is argued in
# ll_play.h). Pins: FIRE,F1 (script comma token, mirroring the .MOV
# group) enters A_FIGHT and the punch frames play; the drawn punch sits
# on the PR-84 anchor (top=121 after PR-135's - the same tripwire
# caveat as the other windows); and FIRE alone does NOT fight (negative
# leg - under the old OR/never-true readings this pair of pins was
# impossible).
# PR-89 note: the entry no longer goes through the A_DRAP hub - with no
# key held the spawn state's BY_X rows get no distance, so there is no
# idle hub to leave (see the ZARIA start/idle leg); the transition line
# is A_WALK -> A_FIGHT now, and the AND semantics it pins are unchanged.
# PR-110 made the PUNCH CLOCK a derivation; PR-135 re-derives it on the
# iteration grid and the arithmetic is shorter now. The real [A_FIGHT]
# row list is 1,2,4,5,6,8 = six rows of 300 units (the 8th carries
# ATC_ON), then 9 (400 with its FC pair), 10 (500), 11 (500), 13 (400,
# ATC_OFF), 15 (400)... The state is not BY_X, so its accumulator is fed
# the engine's fixed 100 units per iteration (0x4c8b7) and admits at most
# one row: the six 300-unit rows take 18 iterations, so the window opens
# on the list's 18th iteration = entry+17 = 37, and the 1400 units up to
# the ATC_OFF row close it 14 iterations later at 51. The frame
# boundaries the run draws - 20, 22, 25, 28, 31, 34, 37, 41, 46, 51, 55 -
# are those same admits, three iterations per 300-unit row and four to
# five per FC-weighted row, line for line; frame 15 is what the sampled
# tick 55 draws. The old clock read those same rows as milliseconds.
# PR-253 moves the x pins of this leg; PR-256 moves them again and the
# reason is the unit. The
# `FC 100,0` / `FC 90,0` / `FC 120,0` pairs on those rows are the
# UNGATED pull of PR-250/PR-251 (channel id 1 - no one-shot gate), so
# while an FC row is CURRENT the x axis is pulled to its target every
# iteration, in the register's own unit - FC 100 is a target of 100
# hundredths = a 1 px step - against the state's own T=30 drag, which
# takes it back to 70 immediately. The pull starts on the row that OPENS the window
# (row 8: `8,300,ATC_ON` and `9,300,FC 100,0` are the same list
# position): the FC pair pulls the x register, and PR-256's reading of
# the unit makes that pull 100 HUNDREDTHS of a px per iteration, not a
# px/s figure - idiv(100,100) is a 1 px step, and the state's own
# T_x=30 drag (line 656) takes the register back to 70 at once, so
# across the ticks this leg samples the punch steps 50 -> 53. The old
# 14 px came from the same word read
# as a velocity in px/s.
# The x window below follows the position, as in the
# other legs - and it starts 16 px left of the position point instead
# of 20: the old window also caught an orange background prop at the
# far side of the lion (that is where the old bottom=197 came from),
# and the numbers below are the lion's own box.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=3 \
	  LEO_PLAY_SCRIPT="20:FIRE,F1" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zfight.ppm LEO_LEVEL_PPM_TICK=55 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zfight.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA fight FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zfight.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_FIGHT' /tmp/opencode/ly_zfight.log \
	  && ! grep -q 'A_DRAP -> A_FIGHT' /tmp/opencode/ly_zfight.log \
	  && grep -q 'play tick 28: state A_FIGHT seq fight frame 5 pos 50,646 grounded 1' \
	      /tmp/opencode/ly_zfight.log \
	  && grep -q 'play tick 37: state A_FIGHT seq fight frame 9 pos 50,646 grounded 1' \
	      /tmp/opencode/ly_zfight.log \
	  && grep -q 'play tick 55: state A_FIGHT seq fight frame 15 pos 53,646 grounded 1' \
	      /tmp/opencode/ly_zfight.log \
	  && python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zfight.ppm \
	      37 81 100 200 orange top=122+-6 bottom=175+-6 \
	  || { echo "play ZARIA fight grep FAILED"; grep 'tick 55' /tmp/opencode/ly_zfight.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_PLAY_SCRIPT="20:FIRE 24:NONE" \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zfire.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA fire-alone FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zfire.log; exit 1; fi
	@test "$$(grep -c 'A_FIGHT' /tmp/opencode/ly_zfire.log)" -eq 0 \
	  && echo "play fight (PR-87): K_FIRE,K_F1 comma group ANDs - FIRE,F1 enters the authored A_FIGHT with its punch frames on the cam anchor, FIRE alone never fights (ok)" \
	  || { echo "play ZARIA fire-alone negative leg FAILED (A_FIGHT appeared)"; \
	    grep A_FIGHT /tmp/opencode/ly_zfire.log; exit 1; }
# PR-274, FOCUS 1 / OI-078: THE WHOLE AUTHORED LADDER-CLIMB
# CHAIN, end-to-end regression net. PR-272 closed the fall that
# tunneled the main ground, and this leg's script now walks the
# whole authored chain for the first time: walk to the ladder,
# JUMP (the K_GEN1 bus, PR-257's row chain: press at 98, bus at
# 104, the ladder settles - every probe line from then reads the
# ladder at state 2), land beside it, walk into the column and
# hold FWD,UP with the position point inside the authored middle
# 70%, x 207..229 (PR-269): the ladder ANSWERS CATCH - `set
# 1400` = AC_DRAB|AC_DRAB_CATCH - first at 148, x 208, where
# x 204 two ticks earlier had answered only `set 400` = AC_DRAB,
# exactly the 70% split; and the .MOV's own
# `A_TURN_BACK(1)=K_UP,AC_DRAB_CATCH` row, which precedes both
# the walk's `A_WALK(x)=K_FWD` and the idle's `A_LOOKUP(1)=K_UP`
# (PR-271), takes it at 150: A_WALK -> A_TURN_BACK, A_LOOKUP
# never runs. Its 1500-unit rows run 15 iterations (PR-83's
# units) -> A_WSP at 165; A_WSP's BY_TY F pair with `T=160,50`
# climbs exactly 1 px an iteration (PR-259's closed form): 652
# at 170 down to 560 at 262, x pinned at 212; at the band's
# lower edge - y 560 of PR-270's P1 (195,480)-(225,560) - the
# ladder answers `set 100` = AC_EDGE (262) and with K_UP still
# held comes A_PODCIAG (263), whose BY_TIME rows
# (300x3+200x3+500+300+200+100 = 2700 units = 27 iterations)
# close at 289 through its own `A_DRAP(1)=AC_BREAK_NEXT`
# (the transition ran inside 262's step; 262+27 = 289).
# The chain's END is NOT the top of the ladder: A_PODCIAG's
# LIFT is unmodelled - PR-273 read the directive layer it runs
# on (`1,300,lock ... 7,500,rdir ... 8,300,unlock` = +0xb6
# bit5) and named the motion source open (its OPENS (i)) - so
# the port drifts 2 px a tick and lands back on the main
# ground: feet 654 + the 28 contact = 682, the .plt line at
# x 212, instead of sitting on the top platform (the .plt line
# `5 98,514;288,520;...` reads y 518 there). When the lift is
# modelled those last two pins are the ones that move; every
# other number above is the fixture's own arithmetic.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=16 \
	  LEO_PLAY_SCRIPT="1:FWD 98:JUMP 100:NONE 136:FWD 150:FWD,UP 275:NONE" \
	  LEO_PLAY_ASK=1 LEO_LEVEL_PPM=/tmp/opencode/ly_climb.ppm \
	  LEO_LEVEL_PPM_TICK=318 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_climb.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA climb chain FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_climb.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_TURN_BACK' /tmp/opencode/ly_climb.log \
	  && grep -q 'play: A_TURN_BACK -> A_WSP' /tmp/opencode/ly_climb.log \
	  && grep -q 'play: A_WSP -> A_PODCIAG' /tmp/opencode/ly_climb.log \
	  && grep -q 'play: A_PODCIAG -> A_DRAP' /tmp/opencode/ly_climb.log \
	  && ! grep -q 'state A_LOOKUP' /tmp/opencode/ly_climb.log \
	  && grep -q 'play tick 146: ladder DRABINKA/drab.mov state 2 ANSWERS the lion (non-solid): set 400' /tmp/opencode/ly_climb.log \
	  && grep -q 'play tick 148: ladder DRABINKA/drab.mov state 2 ANSWERS the lion (non-solid): set 1400' /tmp/opencode/ly_climb.log \
	  && grep -q 'play tick 150: state A_TURN_BACK' /tmp/opencode/ly_climb.log \
	  && grep -q 'play tick 262: ladder DRABINKA/drab.mov state 2 ANSWERS the lion (non-solid): set 100' /tmp/opencode/ly_climb.log \
	  && grep -q 'play tick 294: state A_DRAP seq idle frame 1 pos 212,654 grounded 1' /tmp/opencode/ly_climb.log \
	  && echo "play climb chain (PR-274): the authored ladder climb runs end to end - CATCH only inside the middle 70%, A_TURN_BACK at 150 (A_LOOKUP never), A_WSP 1 px/t, AC_EDGE at the band edge, A_PODCIAG's own 2700-unit clock exits to A_DRAP; the lift's TOP landing stays unmodelled and the leg pins that too (ok)" \
	  || { echo "play ZARIA climb chain grep FAILED"; \
	       grep -E 'play: A_|ANSWERS|state A_(TURN_BACK|WSP|PODCIAG|DRAP) ' \
	         /tmp/opencode/ly_climb.log | tail -12; exit 1; }
# PR-277, FOCUS 1 / OI-078: JUMPING OFF THE LADDER AND RE-CATCHING
# IT - the authored mid-climb exit chain, end to end. A_WSP's own
# row `A_PRE_JUMP(1)=K_JUMP` is key-only, so pressing JUMP at 200
# mid-climb takes it: A_WSP -> A_PRE_JUMP at 200. A_PRE_JUMP's
# third row `2,75,I 250,-1100` is the launch: the I pair applies
# ONCE at row entry (PR-253's one-shot), and the -1100 y pair at
# PR-83's units is -11.00 px/t upward - the recorded apex path
# (623 at 202, rising 8.5, 8, 7... a tick, top 541 at 217) is
# that impulse decaying under PR-259's gravity. A_JUMP's apex at
# y 541 is 23 px BELOW the top platform's line (518 at x 217,
# ZARIA_A.PLT line 5): the leap does not reach the platform, and
# K_UP is still held, so the fall passes the middle of the column
# and A_WALK's authored `A_TURN_BACK(1)=K_UP,AC_DRAB_CATCH` row
# (PR-271's order, PR-269's middle-70% split: x 218 sits inside
# 207..229, so the ask at 218,602 answers `set 1400`) takes the
# CATCH mid-air at 228. A_TURN_BACK lands on the main ground by
# the PR-97/PR-274 contact arithmetic (feet 652+30 = 682, the
# .plt line at x 218), and its authored `A_WSP(1)=AC_BREAK_NEXT,
# AC_DRAB` row re-enters the climb at 243 - the 1 px/t climb
# (PR-259's closed form) resumes: 652 at 246, 649 at 249. Every
# tick above is the fixture's own arithmetic: the 1 px/t climb
# (623 at 199 = 652 - 29), K_JUMP at 200, the I-pair launch,
# the CATCH row at 228, 682-30 = 652 at 234, 649 at 249 =
# 652 - 3. The chain also names a lead: A_PRE_JUMP's
# `A_JUMP(11)=AC_DUP` row shows AC_DUP raised by a surface ask
# (0x3df00 -> the asked's +0xd8 verb -> 0x45320 with
# [asked+0xee], PR-23x/PR-275), the same word A_WSP's
# `A_TURN_BACK(1)=AC_DUP,K_DOWN` row needs - still unmodelled.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=16 \
	  LEO_PLAY_SCRIPT="1:FWD 98:JUMP 100:NONE 136:FWD 150:FWD,UP \
200:FWD,UP,JUMP 201:FWD,UP" \
	  LEO_PLAY_ASK=1 LEO_LEVEL_PPM=/tmp/opencode/ly_cjump.ppm \
	  LEO_LEVEL_PPM_TICK=318 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_cjump.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA ladder-jump FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_cjump.log; exit 1; fi
	@grep -q 'play: A_WSP -> A_PRE_JUMP' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play: A_PRE_JUMP -> A_JUMP' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play: A_JUMP -> A_WALK' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play: A_WALK -> A_TURN_BACK' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play: A_TURN_BACK -> A_WSP' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 199: state A_WSP seq climb frame 7 pos 212,623 grounded 0' \
	       /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 200: state A_PRE_JUMP' /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 203: state A_JUMP seq jump frame 3 pos 215,604 grounded 0' \
	       /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 228: ladder DRABINKA/drab.mov state 2 ANSWERS the lion (non-solid): set 1400' \
	       /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 234: state A_TURN_BACK seq turn_bk frame 4 pos 218,652 grounded 1' \
	       /tmp/opencode/ly_cjump.log \
	  && grep -q 'play tick 249: state A_WSP seq climb frame 5 pos 218,649 grounded 0' \
	       /tmp/opencode/ly_cjump.log \
	  && echo "play ladder-jump (PR-277): K_JUMP mid-climb takes A_PRE_JUMP's own row, its I 250,-1100 launches the leap, the fall re-takes the authored CATCH row at 228, the landing uses the .plt line and the contact of PR-274's arithmetic, and the 1 px/t climb resumes (ok)" \
	  || { echo "play ZARIA ladder-jump grep FAILED"; \
	       grep -E 'play: A_|state A_(WSP|PRE_JUMP|JUMP|WALK|TURN_BACK) ' \
	         /tmp/opencode/ly_cjump.log | tail -12; exit 1; }
# PR-83: the KEYUP half of the input contract. No backend ever translated
# SDL_KEYUP, so through the REAL backend every key stuck down forever: the
# reported "controls press themselves in a loop". The live loop (NO
# LEO_LEVEL_PPM: the fixed-grid legs bypass platform_poll, which is why
# this bug was invisible to them) drives one key through the SDL event
# queue - LEO_TEST_KEY at 50 ms, LEO_TEST_KEY_UP_AFTER_MS release at
# 1300 ms - and pins BOTH edges: A_STAY -> A_WALK_FWD on press,
# A_WALK_FWD -> A_STAY on release.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2.2 \
	  LEO_TEST_KEY=right LEO_TEST_KEY_AFTER_MS=50 LEO_TEST_KEY_UP_AFTER_MS=1300 \
	  timeout 10 ./ll_level $(DATA) RAN.01 --play --no-audio \
	  > /tmp/opencode/ly_keyup.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play key release FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_keyup.log; exit 1; fi
	@grep -q 'play: A_STAY -> A_WALK_FWD' /tmp/opencode/ly_keyup.log \
	  && grep -q 'play: A_WALK_FWD -> A_STAY' /tmp/opencode/ly_keyup.log \
	  && test "$$(grep -c '> A_WALK_FWD' /tmp/opencode/ly_keyup.log)" -eq 1 \
	  && echo "play key release: a real SDL_KEYUP stops the walk (A_WALK_FWD -> A_STAY through !K_FWD) - the reported sticky-input loop is gone (ok)" \
	  || { echo "play key release grep FAILED"; cat /tmp/opencode/ly_keyup.log; exit 1; }
# the SAME runtime on the other level blocks that carry complete player
# sets (inventory measured 2026-11-16 over the full CD + HD-install
# trees: 12 of 13 run their own LEW.* art + .MOV + their own ground;
# the ground is a .PLT for most and a sub-.des for two - see the leg
# below. KADMAR.07's lion lives in an ANIMACJE leaf literally named
# "0", which its .des names exactly, so it runs too).
# ENA.03 additionally pins the '!' point-separator variant (ENA.PLT) on
# real bytes: without it that ground parsed to zero lines.
	@for L in ENA.03 ENA2 KARA.07 KADMAR.07 KADMAR2 LONA.05 ZARIA.01 ZARIA.02; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_multi_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=12 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_multi_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play multi-level $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; fi; \
	  grep -qE 'play: [A-Za-z0-9_.]+ [0-9]+ state\(s\) on [0-9]+ polyline' \
	      /tmp/opencode/ly_multi_$$L.log || { echo "play multi-level $$L not wired"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; }; \
	  grep -qE 'play tick 12: state A_' /tmp/opencode/ly_multi_$$L.log || \
	    { echo "play multi-level $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: ENA.PLT: 1 polyline' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'spawn feet (100,538) grounded=1' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'play tick 12: state A_SWIM' /tmp/opencode/ly_multi_ENA.03.log \
	  && echo "play multi-level: 8 more levels run their OWN lion data (zero special-casing); ENA.PLT '!' separator + the ENA.03 A_SWIM state prove the extended grammar on real bytes" \
	  || { echo "play multi-level ENA.03 grep FAILED"; cat /tmp/opencode/ly_multi_ENA.03.log; exit 1; }
# PR-44: the SECOND real form of `platformy=`. Two level blocks point it
# at a sub-.des of their own block instead of a .PLT, and that record's
# TEXT is the very same polyline grammar (count header and all): TUNGA2.12
# and SADES.06 say platf.des, whose PLATF.DES record starts
# "66\r\n1 1495,147;..." / "8\r\n1 863,166;...". Same parser, so these
# two levels run their own lion on their own ground - no special casing.
	@for L in TUNGA2.12 SADES.06; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_desground_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=12 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_desground_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ground-from-.des $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; fi; \
	  grep -q 'play: PLATF.DES: [0-9]* polyline' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: ground not read"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; }; \
	  grep -qE 'spawn feet \([0-9]+,[0-9]+\) grounded=1' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: spawn not snapped on it"; exit 1; }; \
	  grep -qE 'play tick 12: state A_' /tmp/opencode/ly_desground_$$L.log || \
	    { echo "play ground-from-.des $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: PLATF.DES: 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'LEW.TUN 33 state(s) on 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'spawn feet (50,290) grounded=1' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'play: PLATF.DES: 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'LEW.SAD 37 state(s) on 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'spawn feet (20,138) grounded=1' /tmp/opencode/ly_desground_SADES.06.log \
	  && echo "play ground-from-.des: platformy= has TWO real forms (a .PLT, or a sub-.des holding the same polylines) - both levels now run their own lion on their own ground" \
	  || { echo "play ground-from-.des exact-count grep FAILED"; \
	    cat /tmp/opencode/ly_desground_TUNGA2.12.log /tmp/opencode/ly_desground_SADES.06.log; \
	    exit 1; }
# ...and the THIRD answer a level can give: JUNCTION says platformy=none.des
# and its NONE.DES record is literally "0". That is an AUTHORED empty
# ground (the level has no floor), not a missing file, so it must print as
# "has NO ground in its own data" and never as the "lacks"/"no .PLT" data
# hole. Same rule for the bare `none` keyword in the other .des lists
# (JUNCTION animacje=none, RAN.01 zwierzaki=...,none): it means "nothing
# here", so no false 'not in the HD level block (data hole)' note and no
# invented placements from the fallback scan.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_PLAY_SCRIPT="1:FWD" LEO_LEVEL_PPM=/tmp/opencode/ly_noground.ppm \
	  LEO_LEVEL_PPM_TICK=12 \
	  ./ll_level $(DATA) JUNCTION --play --no-audio \
	  > /tmp/opencode/ly_noground.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play JUNCTION authored-empty FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_noground.log; exit 1; fi
	@grep -q 'play: NONE.DES: 0 polyline' /tmp/opencode/ly_noground.log \
	  && grep -q 'has NO ground in its own data' /tmp/opencode/ly_noground.log \
	  && grep -q 'authored scene JUNCTION: 0 placement file(s), 0 object' \
	      /tmp/opencode/ly_noground.log \
	  && ! grep -q 'lacks ground' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'not in the HD level block' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'll_level: placement' /tmp/opencode/ly_noground.log \
	  && echo "play authored-empty ground: platformy=none.des = '0' is DATA (no floor), reported as such, and the bare 'none' keyword is never a fake data hole" \
	  || { echo "play authored-empty ground grep FAILED"; cat /tmp/opencode/ly_noground.log; \
	    exit 1; }
# per-level data: TUNGA.11 has its OWN complete player set (LEW.TUN art,
# 36-state LEW.MOV, TUNGA.PLT 7 lines, lew_rect -100..1570) - the runtime
# is generic, the level data drives everything.
# PR-83 re-pinned the spawn half: the lion starts in the .MOV's DECLARED
# first state (A_WALK here, A_SWIM on ENA.03) - the egg intro is NOT a
# spawn state: [A_DRAP] reaches A_GIVE_EGG only via K_FIRE,K_F6, and the
# block-0 start that showed it at spawn was a model artifact (the 0021
# art is still loaded, by the egg's own placement).
# PR-110 re-pinned the frame number; PR-135 re-pinned it on the
# iteration grid; PR-256 re-derives it on the integer register and it is
# still arithmetic: TUNGA's own [A_WALK] is BY_X, F=100 T=20 - the same
# words as ZARIA's - so the register walks 50, 90, 122, 148, 169, 186,
# 199, 210 and the body's step is idiv(v,100) = 0, 0, 1, 1, 1, 1, 1, 2,
# 2, ... px. By iteration 12 he has travelled 15 px (x 65, the next pin
# reads) and exactly TWO of his 6-unit travelled-distance rows have
# closed - at iterations 8 and 11 - so list index 2 = frame 12 is what
# tick 12 draws. The
# old pins (frame 11 at tick 30, and frame 2 before PR-110) were the ms
# clock cycling that list every 72 ms.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD" LEO_LEVEL_PPM=/tmp/opencode/ly_tun.ppm \
	  LEO_LEVEL_PPM_TICK=12 \
	  ./ll_level $(DATA) TUNGA.11 --play --no-audio \
	  > /tmp/opencode/ly_tun.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play TUNGA.11 FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_tun.log; exit 1; fi
	@grep -q 'play: art LEW.TUN/0021.SEQ: 10 element' /tmp/opencode/ly_tun.log \
	  && grep -q 'play: TUNGA.PLT: 7 polyline' /tmp/opencode/ly_tun.log \
	  && grep -q 'spawn feet (50,370) grounded=1 bounds -100..1570' \
	      /tmp/opencode/ly_tun.log \
	  && grep -q 'play tick 12: state A_WALK seq 0003 frame 12 pos 65,369' \
	      /tmp/opencode/ly_tun.log \
	  && echo "play per-level: TUNGA.11 LEW.TUN set spawns in its declared A_WALK and walks its own .plt/bounds on FWD (no level special-casing in code)" \
	  || { echo "play TUNGA.11 grep FAILED"; cat /tmp/opencode/ly_tun.log; exit 1; }
else
	@echo "verify-play: SKIP data legs (needs $(DATA) + LEO_HD_DIR fixtures; see NEXT_STEPS.md)"
endif

# Level help overlay (POMOC flow): HD .MNU page list + CD ETAPY .SEQ page
# art. JUNCTION carries page art AND the whole scene is one .PCX, so the
# help frame dump must be the bare bg plus exactly the page-0 window
# (element anchor (-f0,-f2)), with a pixel count matching the python oracle.
verify-help: ll_level llrs_selftest
ifeq ($(PX_DATA),1)
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0.5 LEO_LEVEL_SECS=0.5 \
	  timeout 120 ./ll_level $(DATA) TUNGA.11 \
	  > /tmp/opencode/help_tunga.log 2>&1; \
	if grep -q 'help: POMOC1.MNU page 0 pomoc00.seq at (99,3)' /tmp/opencode/help_tunga.log \
	   && grep -q 'page 1 pomoc02.seq at (229,55)' /tmp/opencode/help_tunga.log \
	   && grep -q 'page 6 POMOC32.SEQ at (43,44) \[CD\]' /tmp/opencode/help_tunga.log; \
	then echo "help wiring: .MNU pages + CD POMOC<NN>.SEQ join (PR-36: more page-art records resolve) (ok)"; \
	else echo "help wiring FAILED"; cat /tmp/opencode/help_tunga.log; exit 1; fi
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0.5 LEO_LEVEL_SECS=0.5 \
	  LEO_HELP_PPM=/tmp/opencode/help_junction.ppm timeout 120 \
	  ./ll_level $(DATA) JUNCTION >/dev/null 2>&1 || true
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_LEVEL_NO_OBJ=1 \
	  LEO_LEVEL_PPM=/tmp/opencode/bare_junction.ppm LEO_LEVEL_PPM_TICK=0 \
	  timeout 120 ./ll_level $(DATA) JUNCTION >/dev/null 2>&1 || true
	python3 tools/verify_help.py /tmp/opencode/help_junction.ppm \
	  /tmp/opencode/bare_junction.ppm $(DATA)/ETAPY JUNCTION POMOC00.SEQ \
	  99 215 3 33
else
	@echo "verify-help: SKIP (needs $(DATA)/ETAPY/HELP/INFO3.12P; see the restaging recipe in NEXT_STEPS.md"
endif

# ll_cutscene.exe is a prerequisite because the last legs compare wine
# frames against fresh linux frames (same stale-binary trap as verify-win:
# after the PR-36 PCX header fix the old .exe shifted every frame by 64
# bytes and "win selected TAK frame != linux" was a false alarm).
verify-menu: ll_cutscene ll_cutscene.exe
ifeq ($(PX_DATA),1)
	@env -u DISPLAY LEO_DEMO_SKIP_FRAMES=5 LEO_SKIP_USER=1 LEO_MENU_AUTO=1 \
	    LEO_LEVEL_SECS=1 timeout 180 \
	    ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_chain.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] && grep -q 'menu: LEO_MENU_AUTO' /tmp/opencode/menu_chain.log \
	   && grep -q 'll_level: show' /tmp/opencode/menu_chain.log; \
	then echo "demo chain: cutscene -> menu -> level intro (hooked, ok)"; \
	else echo "demo chain FAILED (rc=$$rc)"; cat /tmp/opencode/menu_chain.log; exit 1; fi
	@env -u DISPLAY LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_SECS=2 \
	    timeout 120 ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_bg.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] && grep -qE 'map: [0-9]+ chapters' /tmp/opencode/menu_bg.log \
	   && grep -q 'map: anim 0: 30 frames' /tmp/opencode/menu_bg.log; \
	then echo "menu render: 640x400 chapter map + BERLO arrow anim attached (hooked, ok)"; \
	else echo "menu render FAILED (rc=$$rc)"; cat /tmp/opencode/menu_bg.log; exit 1; fi
# ONE run for the two animation frames (2026-11-19). This pair used to
# replay the whole chain twice, once per tick. It is safe to collapse
# because the two hooks emit the same bytes at the same tick - proven,
# not assumed: LEO_MENU_PPM+TICK and LEO_MENU_PPM_DIR+MAX both call
# ppm_fb on the same composed buffer (ported/ll_menu.c:1288 vs :1305),
# and hashing a single-shot run against a sequence run gave identical
# frames on BOTH targets (t2 sha 14c5ef3b..., t8 e41b61fd...; linux==wine
# in all four combinations), while t2 != t8 inside one run, which is
# exactly the assertion here. MAX=8 emits map_0000..map_0008.
	@rm -rf /tmp/opencode/menu_seq; mkdir -p /tmp/opencode/menu_seq
	@env -u DISPLAY LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_SECS=1 \
	    LEO_MENU_PPM_DIR=/tmp/opencode/menu_seq LEO_MENU_PPM_MAX=8 \
	    timeout 60 ./ll_cutscene --demo $(DATA) >/dev/null 2>&1 || true
	@if tools/frames_differ.sh /tmp/opencode/menu_seq/map_0002.ppm \
	                       /tmp/opencode/menu_seq/map_0008.ppm; \
	then echo "menu anim: BERLO frame cycles on screen (t2 != t8, ok)"; \
	else echo "menu anim FAILED: frames t2 == t8 (nothing animates)"; exit 1; fi
	@env -u DISPLAY SDL_VIDEODRIVER=dummy LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 \
	    LEO_MENU_KEY=corner LEO_MENU_SECS=2 timeout 90 \
	    ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_corner.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] \
	   && grep -q 'map: LEO_MENU_KEY -> corner cycle' /tmp/opencode/menu_corner.log \
	   && grep -q 'map: corner art wyjscie' /tmp/opencode/menu_corner.log \
	   && grep -q 'map: corner art restart' /tmp/opencode/menu_corner.log \
	   && grep -q 'map: corner restart' /tmp/opencode/menu_corner.log \
	   && [ "$$(grep -c 'map: title sprite' /tmp/opencode/menu_corner.log)" -eq 11 ]; \
	then echo "corner cycle: two-axis walk (Right through all 11 cursive " \
	     "title poses, Down into corner mode, Right to RESTART) with " \
	     "word .SEQ emphasis art, Enter activates RESTART (ok)"; \
	else echo "corner cycle FAILED (rc=$$rc)"; cat /tmp/opencode/menu_corner.log; exit 1; fi
	@env -u DISPLAY SDL_VIDEODRIVER=dummy LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 \
	    LEO_MENU_KEY=r LEO_MENU_SECS=1 LEO_MENU_PPM=/tmp/opencode/menu_rst.ppm \
	    LEO_MENU_PPM_TICK=10 timeout 60 \
	    ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_rst.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] \
	   && grep -q 'map: LEO_MENU_KEY -> restart' /tmp/opencode/menu_rst.log \
	   && grep -q 'menu: anim 0: 1 frames at (82,86)' /tmp/opencode/menu_rst.log \
	   && grep -q 'menu: anim 3: 2 frames at (171,146)' /tmp/opencode/menu_rst.log \
	   && grep -q 'restart-confirm exit ends menu chain' /tmp/opencode/menu_rst.log; \
	then echo "restart-confirm: OPTIONS.PCX + RESTGRY/TAK/CNIE/X cursive sprites (reconstruction, ok)"; \
	else echo "restart-confirm FAILED (rc=$$rc)"; cat /tmp/opencode/menu_rst.log; exit 1; fi
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r \
	    LEO_MENU_PICK=t LEO_MENU_SECS=1 LEO_LEVEL_SECS=2 LEO_HELP_SECS=0 \
	    timeout 90 \
	    ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_tak.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] \
	   && grep -q "zone TAK.SEQ (82,128)-(142,163) key 't'" \
	      /tmp/opencode/menu_tak.log \
	   && grep -q 'restart confirmed (tak) -> new game' \
	      /tmp/opencode/menu_tak.log \
	   && grep -q 'map: LEO_MENU_SECS expired' /tmp/opencode/menu_tak.log; \
	then echo "restart-confirm TAK: answer buttons (keys), restart -> new game -> back to map (ok)"; \
	else echo "restart-confirm TAK FAILED (rc=$$rc)"; cat /tmp/opencode/menu_tak.log; exit 1; fi
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r \
	    LEO_MENU_NAV=1 LEO_MENU_SECS=1 LEO_LEVEL_SECS=2 LEO_HELP_SECS=0 \
	    timeout 90 \
	    ./ll_cutscene --demo $(DATA) > /tmp/opencode/menu_nav.log 2>&1; \
	rc=$$?; \
	if [ $$rc -eq 0 ] \
	   && grep -q 'LEO_MENU_NAV -> zone TAK.SEQ' /tmp/opencode/menu_nav.log \
	   && grep -q 'restart confirmed (tak) -> new game' \
	      /tmp/opencode/menu_nav.log \
	   && grep -q 'map: LEO_MENU_SECS expired' /tmp/opencode/menu_nav.log; \
	then echo "restart-confirm keyboard nav: arrows cycle TAK first, Enter confirms (ok)"; \
	else echo "restart-confirm keyboard nav FAILED (rc=$$rc)"; cat /tmp/opencode/menu_nav.log; exit 1; fi
# Bright-green answer selection (user: "TAK (YES) should be bright green on
# select, as NIE (NO) by default"). Same dialog frame, three selection
# states: open (default), LEO_MENU_SEL=0 (TAK), LEO_MENU_SEL=1 (CNIE).
# tools/verify_green.py is the numeric oracle: the open frame must equal the
# CNIE frame byte-for-byte, and selecting TAK may only change pixels inside
# the TAK rect + the two underline strips, with the word's ink moved UP the
# palette's green ramp (idx15 #0aa712 -> idx22 #10f91b, mean lum up).
# Baseline argument "-" = skip the pre-fix frame comparison (CI has no old
# build); locally re-run it against a build of the previous commit.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r LEO_MENU_SECS=1 \
	  LEO_MENU_PPM_TICK=10 LEO_MENU_PPM=/tmp/opencode/rst_def.ppm timeout 60 \
	  ./ll_cutscene --demo $(DATA) > /tmp/opencode/rst_def.log 2>&1 \
	  || { echo "restart-confirm frame def FAILED"; cat /tmp/opencode/rst_def.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r LEO_MENU_SECS=1 \
	  LEO_MENU_SEL=0 LEO_MENU_PPM_TICK=10 LEO_MENU_PPM=/tmp/opencode/rst_tak.ppm \
	  timeout 60 ./ll_cutscene --demo $(DATA) > /tmp/opencode/rst_tak.log 2>&1 \
	  || { echo "restart-confirm frame tak FAILED"; cat /tmp/opencode/rst_tak.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r LEO_MENU_SECS=1 \
	  LEO_MENU_SEL=1 LEO_MENU_PPM_TICK=10 LEO_MENU_PPM=/tmp/opencode/rst_cnie.ppm \
	  timeout 60 ./ll_cutscene --demo $(DATA) > /tmp/opencode/rst_cnie.log 2>&1 \
	  || { echo "restart-confirm frame cnie FAILED"; cat /tmp/opencode/rst_cnie.log; exit 1; }
	@if grep -q 'menu: default answer CNIE.SEQ' /tmp/opencode/rst_def.log \
	   && grep -q 'menu: tint TAK.SEQ: selected +7 / idle +0' \
	      /tmp/opencode/rst_tak.log \
	   && grep -q 'menu: tint CNIE.SEQ: selected +0 / idle -7' \
	      /tmp/opencode/rst_cnie.log; \
	then echo "answer-state tint hooks: default CNIE, TAK +7/0, CNIE 0/-7 (ok)"; \
	else echo "answer-state tint hooks FAILED"; cat /tmp/opencode/rst_def.log; exit 1; fi
	@python3 tools/verify_green.py - /tmp/opencode/rst_def.ppm \
	  /tmp/opencode/rst_tak.ppm /tmp/opencode/rst_cnie.ppm \
	  82 128 142 163 169 145 233 183 155 54 169 68
	@env -u DISPLAY WINEPREFIX=$(WINEPREFIX) WINEDEBUG=-all \
	  SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_DEMO_SKIP_FRAMES=3 LEO_SKIP_USER=1 LEO_MENU_KEY=r LEO_MENU_SEL=0 \
	  LEO_MENU_SECS=1 LEO_MENU_PPM_TICK=10 \
	  LEO_MENU_PPM=Z:/tmp/opencode/wrst_tak.ppm timeout 90 \
	  wine ./ll_cutscene.exe --demo Z:$(DATA) > /tmp/opencode/wrst_tak.log 2>&1 || true
	@cmp /tmp/opencode/rst_tak.ppm /tmp/opencode/wrst_tak.ppm \
	  && echo "win selected TAK frame == linux frame (byte-exact, tint is palette-index math)" \
	  || { echo "win selected TAK frame != linux"; cat /tmp/opencode/wrst_tak.log; exit 1; }
else
	@echo "verify-menu: SKIP (needs $(DATA)/ETAPY/INFO/MAPKA + ANIMACJE; see the restaging recipe in NEXT_STEPS.md"
endif

# MOD music: ported/ll_mod.c parses the Longsoft repack layout (ll_mod.h)
# and renders deterministically; linux vs wine hash parity is the oracle.
# Payloads come straight out of the SOUND llrs container.
mod_selftest: tools/mod_selftest.c ported/ll_mod.c ported/ll_mod.h
	$(CC) -O1 -g -std=gnu11 -Wall -Wextra $(SAN) \
	    -Iported -o $@ tools/mod_selftest.c ported/ll_mod.c

mod_selftest.exe: tools/mod_selftest.c ported/ll_mod.c ported/ll_mod.h
	$(XC) -O1 -std=gnu11 -Wall -Wextra -Iported -o $@ \
	    tools/mod_selftest.c ported/ll_mod.c

# T-01: headless engine-contract test. Deliberately built with the
# DUMMY platform backend and NO SDL at all (only is_stream + fs_ci): a
# successful link+run proves the decode->present->audio->clock->input
# surface is SDL-free, i.e. exactly the "can't test the engine without
# SDL" barrier T-01 removes. ASan/UBSan like the other headless tools.
platform_selftest: tools/platform_selftest.c ported/platform.h \
        ported/platform_dummy.c ported/platform_common.c ported/fs_ci.c \
        ported/is_stream.c ported/is_stream.h
	$(CC) -O1 -g -std=gnu11 -Wall -Wextra -DPLAT_BACKEND_DUMMY=1 \
	    $(SAN) -Iported -o $@ \
	    tools/platform_selftest.c ported/platform_dummy.c \
	    ported/platform_common.c ported/fs_ci.c ported/is_stream.c -lm

verify-platform: platform_selftest
ifeq ($(PX_DATA),1)
