# PR-85 left-walk (the owner's "the left key turns but he never walks
# left, slides more than it walks, and slow"): Model M - K_FWD/K_BKWD
# are FACING-RELATIVE (recorded in ll_play.c cond_true: ZARIA authors
# ONE walk state and no backward-walk state, so literal keys could
# never walk left at all). Held BKWD from face=+1: A_DRAP -> A_TURN
# (the turn, its CH_DIR flips face=-1), the frame-list WRAP arms
# AC_BREAK_NEXT - A_TURN's OWN exit line (the real .MOV lists only
# AC_BREAK_NEXT/PREV) - back to the A_DRAP hub, and there the held
# LEFT key IS K_FWD at face=-1: A_WALK walks LEFT. Pins: A_TURN entered
# EXACTLY once, the hub hand-off, and x DECREASING while walking at the
# register's settled 2 px per iteration - "slides more than it walks" is
# gone: the A_TURN
# F=0 slide hands over into real walking, plus the drawn art at the PR-84
# anchor in the MIRRORED walk pose (window built from the logged
# position, zcam method).
# PR-110 moved the hand-off and the two position windows; PR-135 re-pins
# the chain on the iteration grid, and the mechanism half is arithmetic:
# A_TURN enters at 52, its five 200-unit rows admit ONE per iteration
# (the entry step feeds the first, then two iterations per row), the list
# re-runs its first row at entry+9 = 61, that wrap arms AC_BREAK_NEXT and
# the next iteration reads it: A_DRAP hands over at 62 and A_WALK starts
# at face=-1 at 63, drawn at 124,649. From there he walks LEFT, and the
# cap is the settled register 250 = 2 px per iteration, so between 63 and
# 82 the law allows at most 19*2 = 38 px; the log moves him
# 124 -> 93, i.e. 31 px in 19 iterations: the law's own ramp from rest
# (0,0,1,1,1,1,1 then 2 - 29 px) PLUS the velocity he carries into the
# hand-off from A_TURN and A_DRAP, which this model keeps across a
# transition - that difference is the carry-in term, and the PR-135
# record counts it as an open item. The
# x values the pins below read are the run's own.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD 40:NONE 52:BKWD" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zwalk.ppm LEO_LEVEL_PPM_TICK=82 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zwalk.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA left-walk FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zwalk.log; exit 1; fi
	@test "$$(grep -c '> A_TURN' /tmp/opencode/ly_zwalk.log)" -eq 1 \
	  && grep -q 'play: A_TURN -> A_DRAP' /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play: A_DRAP -> A_WALK' /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play tick 70: state A_WALK seq walk .* pos 11[0-9],649 grounded 1' \
	      /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play tick 82: state A_WALK seq walk .* pos 9[0-9],649 grounded 1' \
	      /tmp/opencode/ly_zwalk.log \
	  || { echo "play ZARIA left-walk grep FAILED"; cat /tmp/opencode/ly_zwalk.log; exit 1; }
	@X=$$(grep -o 'play tick 82: state A_WALK seq walk frame [0-9-]* pos [0-9]*,649' \
	    /tmp/opencode/ly_zwalk.log | sed 's/.*pos \([0-9]*\),.*/\1/'); \
	  python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zwalk.ppm \
	    $$((X-20)) $$((X+28)) 100 200 orange top=118+-6 bottom=173+-6 \
	  && echo "play left-walk (PR-85 Model M): held BKWD turns ONCE (AC_BREAK_NEXT at the A_TURN list wrap - its own exit line), then A_WALK walks LEFT at the T=20 cap, mirrored art stays on the measured cam anchor (ok)" \
	  || { echo "play ZARIA left-walk cam-y grep FAILED"; grep -E 'tick (70|82):' /tmp/opencode/ly_zwalk.log; exit 1; }
# PR-86 jump: the (N) token decoded as the TARGET's START ROW (evidence
# in ll_mov_tr.entry) and a state that DECLARES an AC_BREAK_NEXT exit
# ends at its own frame-list WRAP - no external rule cuts the state
# short (the forced-idle stays only as a fallback for states without
# such a line; the JM selftest fixture covers that branch).
# ZARIA.01 walk + one JUMP press pins the full authored flow: the
# recovery rows play out (A_JUMP's 900-unit crouch row); the list wrap
# arms AC_BREAK_NEXT -> A_WALK(7) = the walk cycle's ROW 7 re-join
# (frame cursor 7, NOT 1).
# The row machine is arithmetic, and this is the law it runs by: a
# state whose rows are not distance-fed gets its accumulator fed the
# engine's fixed 100 units per iteration (0x4c8b7, ll_play.c:1371) and
# admits AT MOST ONE row per iteration (0x521f0 / 0x5232b). ZARIA's real
# [A_JUMP] rows are 75,75,75,100,150,150,225,900,225,(0 + WAIT gate),
# 150 units - and rows 2,2,2 all draw the SAME frame 2, which is why the
# frame changes lag the admits: 40 (the entry iteration feeds the first
# row), then 43, 44, 46, 48 - the 75-unit rows admit every iteration and
# the visible frame only moves when the row's frame number differs. The
# 900-unit crouch row spans 9 iterations and lands its frame 7 at 57; the
# `8,0,WAIT AC_DUP` row's own gate holds the next one to 59; the list
# wraps at 62 and the state's own A_WALK(7)=AC_BREAK_NEXT line takes him
# out at 63. None of that depends on the physics, and it did not move.
# PR-256 REPLACES THE ARC'S UNITS. The vertical is the measured pull
# law: row 0's `F 0,350` cannot break the contact while the ground still
# holds him (the log reads grounded 1 at 40, on the 649 line), row 1's
# breaks it at 41, and the row-2 `I 150,-1200` admitted at 42 pulls the
# y register to its target through 0x54170 - the word IS the register,
# hundredths of a px per iteration, no divisor. From there the whole
# flight is that integer: the drag is idiv(1*v,100) of the OLD register
# (`T=20,1`), the header's `G=0,55` word adds 55 to the register EVERY
# iteration, so the first step is idiv(-1200 + 55 + 12, 100) = -11 px,
# the sign-cross zero of 0x5430a/0x54325 never fires (no sign cross
# happens), and the position step adds those WHOLE px. The
# steps are 11, 10, 10, 9, 8, 8, 7, 6, 6, 5, 5, 4, 4, 3, 3, 2, 2, 1, 1,
# 0 px and the apex is 100 px above the line, min y 549, at ticks
# 58..60. The test does NOT pin those numbers: tools/jump_law_measure.py
# recomputes the closed form from the authored words - the /5 unit, the
# drag-of-the-old-v, then G, then sign-cross-zero order of 0x54250 - and
# fails on any drift from it. PR-253 had carried 108 px from the old
# x4-units reading of the G word; at the register's own unit the same
# words give exactly 100. The old PR-73/74 fit (I/4, g=1650) reached 20
# px, and the ~24 px PR-73 measured on the video's vine jump is still in
# open tension with both: nothing read in 0x54170/0x54250 scales a
# player's y pair down, and the one unread scalar on that path
# ([obj+0x6d]) belongs to the X leg (PR-252). OI-015 carries it.
# THE AIR NOW OUTLASTS THE ROW LIST, and that changes the flow this leg
# describes. The flight runs 41..68 while the 2250-unit list ends at
# 62, so the wrap exit lands mid-air: the tick-63 line is A_WALK at
# 124,556, grounded 0, 100 px up - the (N) token is still pinned by
# what it draws there, authored frame 4 = list index 6 of ZARIA's
# ROTATED walk list - and the landing is no longer inside A_JUMP.
# A_WALK's own header `G=30,350` (line 119 of ZARIA.01 - the state's
# own fall rate, added on the airborne path) takes him down; his rows
# close on the travelled distance, and the `GEN AC_TIME` row reaches
# A_DRAP at 70 while he is still falling - and the ground catches him
# THERE (PR-272). Until PR-272 this leg PINNED the port losing him:
# A_DRAP's `G=0,250 T_y=15` walks the y steps out to 17-20 px, the
# landing search started only LL_PLAY_STEP above THIS iteration's line,
# and the 681 px grass at x 128 was stepped over UNSEEN (668 at 70 ->
# 688 at 71); PR-256 named that a real defect, not a re-pin, in the
# engine's shape-box ground law (FUN_00042a70 / push-out 0x42de0, the
# OI-073 row). PR-272 models the continuity that law forces: the
# landing sweep now starts at the contact line the PREVIOUS iteration
# ended on, so a line crossed during an iteration is seen on that
# iteration. The pins below re-derive from that: the main ground
# (`-50,680!408,684`) at x 128 reads 681; the feet land ON it (653 +
# the idle shape's 28 px contact = 681, PR-97's `pos = line -
# contact`), and he STAYS: grounded 1 from 70 on, x drifting 128 ->
# 122 only by the LICHA SEMI push-out, the y pinned at 653. The
# airborne canvas is not measured either way: the view's ease toward
# the anchor belongs to the follow model, not to this leg.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=4 \
	  LEO_PLAY_SCRIPT="1:FWD 40:JUMP 52:NONE" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zjump.ppm LEO_LEVEL_PPM_TICK=63 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zjump.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA jump FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zjump.log; exit 1; fi
# Second run of the same script, sampled at tick 82: the first run ends
# when ITS PPM tick is written (63) and the flow this leg pins runs past
# that - the mid-air hand-over at 69, the surface re-seating him on the
# next iteration, the idle the AC_TIME chain leaves him in. The canvas
# THIS run writes is the one measured below.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=4 \
	  LEO_PLAY_SCRIPT="1:FWD 40:JUMP 52:NONE" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zland.ppm LEO_LEVEL_PPM_TICK=82 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zland.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA jump land-run FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zland.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_JUMP' /tmp/opencode/ly_zjump.log \
	  && ! grep -q 'A_JUMP -> A_DRAP' /tmp/opencode/ly_zjump.log \
	  && grep -q 'play: A_JUMP -> A_WALK' /tmp/opencode/ly_zjump.log \
	  || { echo "play ZARIA jump grep FAILED"; cat /tmp/opencode/ly_zjump.log; exit 1; }
# PR-253: the arc against the closed form of the authored words (the
# `I 150,-1200` pair, the `T=20,1` drag, the `G=0,55` header): the
# tool derives 108 px / 20 climbing iterations from those bytes and
# compares with the log. The PR-73/74 /4 + 1650 fit reached 20 px and
# fails this check by construction.
	@python3 tools/jump_law_measure.py /tmp/opencode/ly_zjump.log 649 1200 55 1
	@grep -q 'play tick 63: state A_WALK seq walk frame 4 pos 124,556 grounded 0' \
	    /tmp/opencode/ly_zjump.log \
	  && grep -q 'play tick 70: state A_DRAP seq idle frame 1 pos 128,653 grounded 1' \
	      /tmp/opencode/ly_zland.log \
	  && grep -q 'play tick 71: state A_DRAP seq idle frame 1 pos 128,653 grounded 1' \
	      /tmp/opencode/ly_zland.log \
	  && grep -q 'play tick 82: state A_DRAP seq idle frame 1 pos 122,653 grounded 1' \
	      /tmp/opencode/ly_zland.log \
	  && grep -qE 'tick (7[1-9]|8[0-2]): .* A_DRAP .* grounded 1' /tmp/opencode/ly_zland.log \
	  && echo "play jump (PR-86 + PR-253/256): the (N) token is the target's" \
	       "START ROW on real rotated data (authored frame 4 at the exit)," \
	       "the row list runs its own 22-row clock through the whole" \
	       "flight, the wrap exits via its OWN A_WALK(7)=AC_BREAK_NEXT -" \
	       "mid-air, because the pull law's 100 px arc outlasts the list" \
	       "(the arc is the closed form of the authored words, not a" \
	       "fit); the state's own G=30,350 brings him down, the walked" \
	       "rows' GEN AC_TIME line reaches A_DRAP while he is still" \
	       "falling, and the ground CATCHES him there (PR-272): the" \
	       "landing sweep starts at the previous iteration's contact" \
	       "line, so the 17 px step over the 681 grass is seen, the" \
	       "feet seat on the line (653 + the idle shape's 28 contact)" \
	       "and he stays grounded - x drifts only by the LICHA SEMI" \
	       "push-out (ok)" \
	  || { echo "play ZARIA jump cam-y grep FAILED"; \
	       grep -E 'tick (62|63|69|70|82):' /tmp/opencode/ly_zjump.log \
	         /tmp/opencode/ly_zland.log; exit 1; }
# PR-254, FOCUS 1 / OI-078: THE ASK IS A REQUESTER-CHANNEL WALK, NOT
# A SHAPE MEET. PR-249 found the port never asks the ladder at all:
# its two ask sites sat behind a paired-shape test, while the engine's
# walk 0x4b500 goes from the REQUESTER's CHECK_ZW/CHECK_ANI bits
# through the instance arrays straight into the candidate's answer
# entry +0x78 with NO shape test anywhere (the animals' meet test
# 0x53ae0 lives INSIDE their own entry 0x552e0, which is where the
# port keeps obj_touch_enemy). The ladder's states are BY_TIME with no
# SOLID, and its 42x48 art at (180,510) never meets a lion standing
# on the 650 line under it, so no pair ever reached it. The probe line
# this leg greps is new with this PR (LEO_PLAY_ASK=1, stderr): it is
# the only place where "the pair was asked" and "the raise happened"
# are different facts, which is exactly the distinction the engine
# makes. ZARIA.01's authored ladder carries one contact point,
# (213,507) (PR-242: made absolute at load by 0x44e90, tested against
# the asker's live box at 0x23e00), and the jump is the first thing the
# port reaches that gets near it: from FWD 100 the A_JUMP apexes at
# pos 189,550 and the live box on that frame is 168,517..215,583 - it
# spans the point's x and misses its y by 10 px. PR-256 moved both
# halves of that: the same authored words put the apex at 100 px and not
# 108, and the 2 px walk takes him to x=189 at the press instead of 209,
# which is what puts the point inside the box's x SPAN at last. The ask
# channel is therefore open (120 candidate steps in this run, every one
# of them WITHOUT a shape meet - the lion is 100 px above the ladder's
# art) and what stands between it and K_GEN1 is 0x44ec0's point gate,
# 10 px of y. RED before this PR: zero ask lines at any script.
# Those 10 px are the named next step and PR-256 does not fit them
# away. What the shape of the gap says: the ladder's art hangs
# 510..558 and its authored point is 3 px above its own top, while the
# walk line under it is 650 - a 143 px rise, where A_JUMP's own words
# measure 100. So the point gate is not the trigger at all. PR-257
# worked the first lead: THE LADDER'S OWN STATES AND THE K_GEN BUS.
# 0x3f1c0's branches key on the ASKED object's [obj+0x5c] - its
# current state record in the DECLARED-list index space (the same
# table 0x54250's physics pass walks: [obj+0x50] + [obj+0x5c]*4, and
# [obj+0x5c]/[obj+0x50] is exactly how 0x53672's mirror arm indexes a
# state's flag word). Index 1 = the flag branch (a ladder waiting in
# A_UP), 2 = the AC answer packet (the DOWNED rope - that gate sits
# on ladder_answer_for too), anything else takes the verb's tail, no
# answer. And the unroll trigger is not geometry at all: ZARIA.01's
# only K_GEN1 raisers are the lion's OWN row directives - A_JUMP rows
# 4..7 `GEN K_GEN1`, the A_DRAP idle loop, A_FALL_DOWN's `s idle
# 1,300,GEN K_GEN1`, A_DEAD, the fight states - while the consumers
# are the two ladder .MOVs' A_UP (`A_DROP(1)=K_GEN1` + `1,0,WAIT
# K_GEN1`). K_GENn is the level's signal bus: the row admit lands the
# bit on every scripted object, and the ladder takes its A_DROP line
# with no shape, point or distance anywhere in that chain. The open
# leads after it: the A_WSP(3)=AC_DRAB_CATCH,AC_ONAIR entry A_JUMP
# declares (the answer branch raises those, and it needs the rope
# DOWNED - A_DROP's wrap exit into A_DOWN is object-side AC_BREAK_NEXT,
# PR-217's WAIT-meter territory), and RAN.01's A_LADOW climb state.
# PR-257 DERIVES THE TICK FROM THE FIXTURE'S OWN ROWS. A_JUMP's rows
# carry thresholds 75,75,75,100,150,150,225,900,225; the accumulator
# is fed 100 an iteration (0x4c8b7, PR-100), admits AT MOST ONE row
# per iteration with the remainder carried, and the entry iteration
# admits row 1. From the press at 100: r2 at 101 (25+100 >= 75), r3
# at 102, r4 at 103 (75+100 >= 100), r5 at 104 (75+100 >= 150, carry
# 25), r6 MISSES at 105 (25+100 = 125 < 150) and ADMITS at 106 (225
# >= 150). Row 6 IS `4,150,GEN K_GEN1` - the first bus raise, at 106;
# the frame cursor lands on row 7 (frame 5), so the same tick's state
# line reads frame 5 at 189,602, the already-derived PR-256 arc.
# DRAB.MOV and LINA.MOV both DECLARE A_UP,A_DOWN,A_DROP before their
# blocks (decl_idx = 1 + position in that list, 0x53440) - so their
# A_UP is 1: the flag branch is theirs, and from 106 on the ask probe
# prints a state OTHER than 1 - the mid-unroll A_DROP (3) or the
# settled A_DOWN (2), which of them depends on the object-side row
# clock and the `(1)` start-row token, both named and untouched here.
# The K_GEN1 line is not the ladder's alone: KORONA, BAL, POCISK,
# SURPRISE, WODA, ZARROW all name K_GEN1 in authored lines in this
# one level - the bus the port already half-knew (ll_play.c names the
# `K_GEN1 cutscene walkers`). Those objects take their authored lines
# at the same tick; every one of them is data, not collateral.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_PLAY_ASK=1 LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=8 \
	  LEO_PLAY_SCRIPT="1:FWD 100:JUMP 122:NONE" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zask.ppm LEO_LEVEL_PPM_TICK=120 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zask.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA ladder ask FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zask.log; exit 1; fi
	@grep -q 'play tick 119: state A_JUMP seq jump frame 8 pos 189,550 grounded 0' \
	    /tmp/opencode/ly_zask.log \
	  && grep -q 'play tick 106: state A_JUMP seq jump frame 5 pos 189,602 grounded 0' \
	      /tmp/opencode/ly_zask.log \
	  && grep -q 'play tick 106: DRABINKA/drab.mov takes its own K_GEN1' \
	      /tmp/opencode/ly_zask.log \
	  && grep -q 'play tick 106: LINA/lina.mov takes its own K_GEN1' \
	      /tmp/opencode/ly_zask.log \
	  && grep -qE 'play tick 119: asked ladder DRABINKA/drab\.mov at state [23]: .*213,507.*168,517\.\.215,583 -> no' \
	      /tmp/opencode/ly_zask.log \
	  && ! grep -q 'raises K_GEN1 on itself' /tmp/opencode/ly_zask.log \
	  && echo "play ladder ask (PR-257): A_JUMP's own row 6 (`4,150," \
	     "GEN K_GEN1`) admits at tick 106 by the row arithmetic above," \
	     "the K_GEN1 bus reaches the waiting DRABINKA and both LINA" \
	     "ropes with no geometry in the chain, each takes its authored" \
	     "`A_DROP(1)=K_GEN1` line into the unroll, and the ask probe" \
	     "afterwards reads a state OTHER than 1 - the point gate's" \
	     "10 px provably not what the level waits on (ok)" \
	  || { echo "play ZARIA ladder ask grep FAILED"; \
	       grep -E 'asked ladder|takes its own|tick (106|119):' \
	         /tmp/opencode/ly_zask.log; \
	       exit 1; }
